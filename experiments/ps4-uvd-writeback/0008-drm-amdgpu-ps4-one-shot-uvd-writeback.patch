From: Linux psX contributors
Subject: [PATCH 70] drm/amdgpu: add a default-off retained PS4 writeback probe

Apply after the frozen 69-patch token-dev2 candidate. Keep its token-only
flow unchanged and add one guarded owned-page fence-prefix experiment.
Public Linux UVD5 emit_fence provides the 8-DWORD prefix; omit its separate
trap suffix. Requester/coherency behavior on Liverpool remains a hypothesis.
Existing MIT notices and the unchanged GPL-2.0-only planner remain intact.
No firmware bytes, retail decompilation or private capture is included.

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_ps4_map_canary.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_ps4_map_canary.c
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_ps4_map_canary.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_ps4_map_canary.c
@@ -412,6 +412,30 @@
 	return true;
 }
 
+/* Borrow only the first page of the existing, separately mapped 128KiB BO.
+ * The completed precheck and final exclusivity check precede this call.
+ * The original SDMA src/dst/IB evidence and the page inventory stay intact.
+ */
+static bool ps4_canary_writeback_page(struct ps4_canary_state *s,
+				    struct amdgpu_ps4_uvd_writeback *wb)
+{
+	struct ps4_canary_bo *bo = &s->uvd_ib;
+
+	if (s != ps4_canary_retained || !s->ready_mode || !s->submitted ||
+	    !s->fence || !bo->bo || !bo->cpu || ((unsigned long)bo->cpu & 3U) ||
+	    !bo->bo->tbo.resource || !bo->bo->tbo.pin_count ||
+	    bo->bo->tbo.type != ttm_bo_type_kernel ||
+	    bo->bo->tbo.resource->mem_type != TTM_PL_TT ||
+	    amdgpu_bo_size(bo->bo) != PS4_READY_IB_BYTES ||
+	    bo->bo == s->uvd_rb.bo || s->mapped_pages != PS4_READY_MAPPED_PAGES)
+		return false;
+	wb->cpu = bo->cpu;
+	wb->bytes = AMDGPU_GPU_PAGE_SIZE;
+	wb->private_va = PS4_CANARY_VA +
+		(u64)PS4_READY_IB_SLOT * AMDGPU_GPU_PAGE_SIZE;
+	return true;
+}
+
 void amdgpu_ps4_map_canary_run(struct amdgpu_device *adev)
 {
 	struct amdgpu_ring *ring = &adev->sdma.instance[0].ring;
@@ -580,6 +604,7 @@
 	crc = crc32_le(~0U, (u8 *)dst, PS4_CANARY_BYTES) ^ ~0U;
 	if (s->ready_mode) {
 		struct amdgpu_ps4_uvd_ring token_ring = { 0 };
+		struct amdgpu_ps4_uvd_writeback writeback = { 0 };
 
 		r = ps4_canary_exclusive_init(adev);
 		if (r)
@@ -593,9 +618,13 @@
 		if (amdgpu_ps4_uvd_token_requested() &&
 		    !ps4_canary_token_ring(s, &token_ring))
 			ps4_canary_park(adev, "token-owned-ring", -EINVAL);
+		if (amdgpu_ps4_uvd_writeback_requested() &&
+		    !ps4_canary_writeback_page(s, &writeback))
+			ps4_canary_park(adev, "writeback-owned-page", -EINVAL);
 		amdgpu_ps4_uvd_ready_run(adev, s->r1.cpu,
 			(size_t)PS4_READY_R_BYTES, amdgpu_gmc_pd_addr(s->pd.bo),
-			amdgpu_ps4_uvd_token_requested() ? &token_ring : NULL);
+			amdgpu_ps4_uvd_token_requested() ? &token_ring : NULL,
+			amdgpu_ps4_uvd_writeback_requested() ? &writeback : NULL);
 		/* Defensive local terminal path also gives object-only objtool a
 		 * valid continuation for the external readiness helper call.
 		 */
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_ps4_uvd_ready.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_ps4_uvd_ready.c
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_ps4_uvd_ready.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_ps4_uvd_ready.c
@@ -13,11 +13,13 @@
  * UVD IP registration, retries, idle worker or return to TTM clients exists.
  * The default readiness path submits nothing. A separate immutable token gate
  * permits one bounded context-write experiment after the ready convention.
+ * A further immutable writeback gate selects one owned-memory fence prefix.
  * Every outcome parks without releasing firmware or mapped BOs.
  * Ready does not prove DMA quiescence, decoding or a safe shutdown procedure.
  */
 #include <linux/atomic.h>
 #include <linux/crc32.h>
+#include <linux/compiler.h>
 #include <linux/delay.h>
 #include <linux/firmware.h>
 #include <linux/ktime.h>
@@ -90,6 +92,17 @@
 module_param_named(ps4_uvd_token, ps4_uvd_token, bool, 0444);
 MODULE_PARM_DESC(ps4_uvd_token,
 	"One PS4 UVD context-token hypothesis; requires ready+poll_state, always parks (default 0)");
+
+/* Separate immutable gate; never enables ready/token by itself. */
+static bool ps4_uvd_writeback;
+module_param_named(ps4_uvd_writeback, ps4_uvd_writeback, bool, 0444);
+MODULE_PARM_DESC(ps4_uvd_writeback,
+	"One PS4 UVD owned-page writeback hypothesis; requires ready+poll+token, always parks (default 0)");
+
+bool amdgpu_ps4_uvd_writeback_requested(void)
+{
+	return ps4_uvd_writeback;
+}
 
 bool amdgpu_ps4_uvd_token_requested(void)
 {
@@ -789,10 +802,238 @@
 }
 /* TOKEN_FLOW_END */
 
+/* WRITEBACK_FLOW_BEGIN: extracted verbatim by the host fixture. */
+#define PS4_WB_BASELINE 0x43505533U
+#define PS4_WB_VALUE 0x55564433U
+#define PS4_WB_OFFSET 0x40U
+
+struct ps4_wb_memory {
+	u32 word, bad_index, bad_value, bad_expected;
+	bool guards_ok;
+};
+
+static bool ps4_wb_descriptor_valid(const struct amdgpu_ps4_uvd_ring *rb,
+				   const struct amdgpu_ps4_uvd_writeback *wb)
+{
+	unsigned long ring, page;
+
+	if (!ps4_token_descriptor_valid(rb) || !wb || !wb->cpu ||
+	    ((unsigned long)wb->cpu & 3U) || wb->bytes != PS4_UVD_RING_BYTES ||
+	    (unsigned long)wb->cpu > ~0UL - (PS4_UVD_RING_BYTES - 1U) ||
+	    wb->private_va != PS4_READY_IB_VA || (wb->private_va & 0xfffU) ||
+	    (PS4_WB_OFFSET & 3U) || PS4_WB_OFFSET > PS4_UVD_RING_BYTES - 4U ||
+	    wb->private_va > ((1ULL << 40) - 1U) - (PS4_UVD_RING_BYTES - 1U))
+		return false;
+	ring = (unsigned long)rb->cpu;
+	page = (unsigned long)wb->cpu;
+	return !(ring <= page + PS4_UVD_RING_BYTES - 1U &&
+		 page <= ring + PS4_UVD_RING_BYTES - 1U) &&
+		!(rb->private_va < wb->private_va + PS4_UVD_RING_BYTES &&
+		  wb->private_va < rb->private_va + PS4_UVD_RING_BYTES);
+}
+
+/* Original adapter around the unchanged ring planner. Validate all addresses
+ * before any output changes. Public UVD5 fence prefix only; no trap suffix.
+ */
+static enum ps4_uvd_plan_error
+ps4_wb_build_ring(const struct amdgpu_ps4_uvd_ring *rb,
+		 const struct amdgpu_ps4_uvd_writeback *wb,
+		 struct ps4_uvd_ring_request request, struct ps4_uvd_ring_plan *plan)
+{
+	unsigned long output = (unsigned long)plan;
+	unsigned long page;
+	u64 address;
+	u8 *bytes;
+	enum ps4_uvd_plan_error error;
+
+	if (!plan)
+		return PS4_UVD_PLAN_NULL;
+	if (!ps4_wb_descriptor_valid(rb, wb) ||
+	    output > ~0UL - (sizeof(*plan) - 1U))
+		return PS4_UVD_PLAN_RANGE;
+	page = (unsigned long)wb->cpu;
+	if (output <= page + PS4_UVD_RING_BYTES - 1U &&
+	    page <= output + sizeof(*plan) - 1U)
+		return PS4_UVD_PLAN_OVERLAP;
+	address = wb->private_va + PS4_WB_OFFSET;
+	if ((address & 3U) || address >= (1ULL << 40))
+		return PS4_UVD_PLAN_RANGE;
+	error = ps4_uvd_build_ring(rb->cpu, rb->bytes, request, plan);
+	if (error != PS4_UVD_PLAN_OK)
+		return error;
+	bytes = rb->cpu;
+	ps4_uvd_store_le32(bytes + 8, mmUVD_GPCOM_VCPU_DATA0);
+	ps4_uvd_store_le32(bytes + 12, lower_32_bits(address));
+	ps4_uvd_store_le32(bytes + 16, mmUVD_GPCOM_VCPU_DATA1);
+	ps4_uvd_store_le32(bytes + 20, upper_32_bits(address) & 0xffU);
+	ps4_uvd_store_le32(bytes + 24, mmUVD_GPCOM_VCPU_CMD);
+	ps4_uvd_store_le32(bytes + 28, 0);
+	return PS4_UVD_PLAN_OK;
+}
+
+static u32 ps4_wb_guard(unsigned int index)
+{
+	return 0xa5330000U ^ index;
+}
+
+static void ps4_wb_initialize(const struct amdgpu_ps4_uvd_writeback *wb)
+{
+	__le32 *page = wb->cpu;
+	unsigned int i;
+
+	for (i = 0; i < PS4_UVD_RING_BYTES / sizeof(*page); ++i)
+		WRITE_ONCE(page[i], cpu_to_le32(i == PS4_WB_OFFSET / sizeof(*page) ?
+			PS4_WB_BASELINE : ps4_wb_guard(i)));
+}
+
+/* Target is read exactly once, then every other DWORD is inspected. These
+ * sequential reads are evidence for this page, not an atomic DMA snapshot.
+ */
+static void ps4_wb_memory_sample(struct amdgpu_device *adev,
+	const struct amdgpu_ps4_uvd_writeback *wb, struct ps4_wb_memory *sample)
+{
+	const __le32 *page = wb->cpu;
+	unsigned int i;
+	u32 word, expected;
+
+	/* Same helper-level convention as the completed SDMA canary. The helper
+	 * may do nothing on native x86 APUs; no direct cache register is added.
+	 */
+	amdgpu_device_invalidate_hdp(adev, NULL);
+	mb();
+	*sample = (struct ps4_wb_memory) { .guards_ok = true, .bad_index = U32_MAX };
+	sample->word = le32_to_cpu(READ_ONCE(page[PS4_WB_OFFSET / sizeof(*page)]));
+	for (i = 0; i < PS4_UVD_RING_BYTES / sizeof(*page); ++i) {
+		if (i == PS4_WB_OFFSET / sizeof(*page))
+			continue;
+		word = le32_to_cpu(READ_ONCE(page[i]));
+		expected = ps4_wb_guard(i);
+		if (word != expected && sample->guards_ok) {
+			sample->guards_ok = false;
+			sample->bad_index = i;
+			sample->bad_value = word;
+			sample->bad_expected = expected;
+		}
+	}
+}
+
+static __noreturn void ps4_wb_stop(struct amdgpu_device *adev,
+	const char *result, int error, const struct ps4_token_sample *registers,
+	const struct ps4_wb_memory *memory, bool enabled, bool submitted, u64 elapsed)
+{
+	if (memory) {
+		dev_info(adev->dev,
+			"PS4_UVD_WRITEBACK MEMORY target_va=30030a040 word=%08x baseline=%08x expected=%08x guard_words=1023 intact=%d; sequential page observations only\n",
+			memory->word, PS4_WB_BASELINE, PS4_WB_VALUE, memory->guards_ok);
+		if (!memory->guards_ok)
+			dev_err(adev->dev,
+				"PS4_UVD_WRITEBACK GUARD index=%u value=%08x expected=%08x; first mismatch saved\n",
+				memory->bad_index, memory->bad_value, memory->bad_expected);
+	}
+	dev_info(adev->dev,
+		"PS4_UVD_WRITEBACK END result=%s enabled=%d submitted=%d elapsed_us=%llu memory_sampled=%d; retained, no outside-page containment or quiescence/decode claim\n",
+		result, enabled, submitted, div_u64(elapsed, 1000), !!memory);
+	ps4_token_stop(adev, result, error, registers, enabled, submitted, elapsed);
+}
+
+/* EXP003 is one attempt with a fresh identity. No future accepted boot may
+ * reuse this result value, even if this attempt does not observe writeback.
+ */
+static __noreturn void ps4_wb_run(struct amdgpu_device *adev,
+	const struct amdgpu_ps4_uvd_ring *rb, const struct amdgpu_ps4_uvd_writeback *wb,
+	u64 pd_addr, u32 cache_vmid, u32 fault_base, int reset_base)
+{
+	struct ps4_uvd_ring_plan plan;
+	struct ps4_uvd_ring_request request;
+	struct ps4_token_sample sample;
+	struct ps4_wb_memory memory;
+	u64 started, elapsed;
+	u32 initial_word, baseline_readback;
+	bool valid;
+
+	if (!ps4_uvd_writeback || !ps4_uvd_token || !ps4_uvd_ready || !ps4_uvd_poll_state ||
+	    !ps4_wb_descriptor_valid(rb, wb) || !pd_addr ||
+	    (pd_addr & 0xfffU) || (pd_addr >> 12) > U32_MAX)
+		ps4_wb_stop(adev, "WRITEBACK_DESCRIPTOR_OR_GATES", -EINVAL, NULL, NULL, false, false, 0);
+	if (!ps4_token_sample(adev, &sample, PS4_TOKEN_HELD, pd_addr, cache_vmid, fault_base, reset_base))
+		ps4_wb_stop(adev, "WRITEBACK_PRECONDITION", -EIO, &sample, NULL, false, false, 0);
+	initial_word = le32_to_cpu(READ_ONCE(((__le32 *)wb->cpu)[PS4_WB_OFFSET / sizeof(__le32)]));
+	if (initial_word == PS4_WB_VALUE) {
+		dev_err(adev->dev, "PS4_UVD_WRITEBACK STALE word=%08x before CPU initialization\n", initial_word);
+		ps4_wb_stop(adev, "WRITEBACK_STALE_WORD", -EIO, &sample, NULL, false, false, 0);
+	}
+	request = (struct ps4_uvd_ring_request) {
+		.gpu_base = rb->private_va, .baseline = PS4_WB_BASELINE,
+		.token = PS4_WB_VALUE, .context_before_baseline = sample.context,
+		.initial_rptr_raw = sample.rptr, .initial_wptr_raw = sample.wptr,
+	};
+	if (ps4_wb_build_ring(rb, wb, request, &plan) != PS4_UVD_PLAN_OK)
+		ps4_wb_stop(adev, "WRITEBACK_PLAN_REJECTED", -EINVAL, &sample, NULL, false, false, 0);
+	ps4_wb_initialize(wb);
+	dev_info(adev->dev,
+		"PS4_UVD_WRITEBACK PREPARED ring_bytes=4096 submit_dw=16 page_va=%llx target_offset=40 baseline=%08x result=%08x crc=%08x; CMD0 requester/coherency hypotheses\n",
+		wb->private_va, PS4_WB_BASELINE, PS4_WB_VALUE,
+		crc32_le(~0U, rb->cpu, rb->bytes) ^ ~0U);
+	WREG32(mmUVD_CONTEXT_ID, PS4_WB_BASELINE);
+	baseline_readback = RREG32(mmUVD_CONTEXT_ID);
+	if (baseline_readback != PS4_WB_BASELINE) {
+		dev_err(adev->dev, "PS4_UVD_WRITEBACK BASELINE_DIRECT value=%08x expected=%08x; no CORE resample\n",
+			baseline_readback, PS4_WB_BASELINE);
+		ps4_wb_stop(adev, "WRITEBACK_BASELINE_READBACK", -EIO, NULL, NULL, false, false, 0);
+	}
+	mb();
+	amdgpu_device_flush_hdp(adev, NULL);
+	valid = ps4_token_sample(adev, &sample, PS4_TOKEN_HELD, pd_addr, cache_vmid, fault_base, reset_base);
+	ps4_wb_memory_sample(adev, wb, &memory);
+	if (!valid || !ps4_token_expect(&sample, 0, mmUVD_CONTEXT_ID, sample.context, ~0U, PS4_WB_BASELINE) ||
+	    !memory.guards_ok || memory.word != PS4_WB_BASELINE)
+		ps4_wb_stop(adev, "WRITEBACK_PUBLICATION_GUARD", -EIO, &sample, &memory, false, false, 0);
+	started = ktime_get_ns();
+	WREG32(mmUVD_RBC_RB_CNTL, PS4_TOKEN_RBC_FETCH);
+	valid = ps4_token_sample(adev, &sample, PS4_TOKEN_EMPTY, pd_addr, cache_vmid, fault_base, reset_base);
+	ps4_wb_memory_sample(adev, wb, &memory);
+	elapsed = ktime_get_ns() - started;
+	if (elapsed >= PS4_TOKEN_LIMIT_NS)
+		ps4_wb_stop(adev, "WRITEBACK_ENABLE_TIMEOUT", -ETIMEDOUT, &sample, &memory, true, false, elapsed);
+	if (!valid || !ps4_token_expect(&sample, 0, mmUVD_CONTEXT_ID, sample.context, ~0U, PS4_WB_BASELINE) ||
+	    !memory.guards_ok || memory.word != PS4_WB_BASELINE)
+		ps4_wb_stop(adev, "WRITEBACK_ENABLE_GUARD", -EIO, &sample, &memory, true, false, elapsed);
+	mb();
+	elapsed = ktime_get_ns() - started;
+	if (elapsed >= PS4_TOKEN_LIMIT_NS)
+		ps4_wb_stop(adev, "WRITEBACK_BEFORE_SUBMIT_TIMEOUT", -ETIMEDOUT, &sample, &memory, true, false, elapsed);
+	WREG32(mmUVD_RBC_RB_WPTR, plan.publish_wptr_raw);
+	dev_info(adev->dev, "PS4_UVD_WRITEBACK SUBMITTED raw_wptr=16 once; fence prefix only, no trap/IB\n");
+	for (;;) {
+		valid = ps4_token_sample(adev, &sample, PS4_TOKEN_SUBMITTED,
+			pd_addr, cache_vmid, fault_base, reset_base);
+		ps4_wb_memory_sample(adev, wb, &memory);
+		elapsed = ktime_get_ns() - started;
+		if (elapsed >= PS4_TOKEN_LIMIT_NS)
+			ps4_wb_stop(adev, "WRITEBACK_TIMEOUT", -ETIMEDOUT, &sample, &memory, true, true, elapsed);
+		if (!valid)
+			ps4_wb_stop(adev, "WRITEBACK_SUBMITTED_GUARD", -EIO, &sample, &memory, true, true, elapsed);
+		if (!memory.guards_ok)
+			ps4_wb_stop(adev, "WRITEBACK_PAGE_GUARD", -EIO, &sample, &memory, true, true, elapsed);
+		if (sample.context != PS4_WB_BASELINE && sample.context != PS4_WB_VALUE)
+			ps4_wb_stop(adev, "WRITEBACK_UNEXPECTED_CONTEXT", -EIO, &sample, &memory, true, true, elapsed);
+		if (memory.word != PS4_WB_BASELINE && memory.word != PS4_WB_VALUE)
+			ps4_wb_stop(adev, "WRITEBACK_UNEXPECTED_WORD", -EIO, &sample, &memory, true, true, elapsed);
+		if (memory.word == PS4_WB_VALUE && sample.context == PS4_WB_VALUE &&
+		    sample.rptr == PS4_UVD_SUBMIT_DWORDS)
+			ps4_wb_stop(adev, "WRITEBACK_OBSERVED", 0, &sample, &memory, true, true, elapsed);
+		/* A drained ring/context can precede observable memory writeback. */
+		usleep_range(100, 200);
+	}
+}
+/* WRITEBACK_FLOW_END */
+
+
 __noreturn void amdgpu_ps4_uvd_ready_run(struct amdgpu_device *adev,
 				      void *r1_cpu, size_t backing_size,
 				      u64 pd_addr,
-				      const struct amdgpu_ps4_uvd_ring *rb)
+				      const struct amdgpu_ps4_uvd_ring *rb,
+				      const struct amdgpu_ps4_uvd_writeback *wb)
 {
 	struct ps4_ready_guard_sample guard_sample = { 0 };
 	bool vcpu_seen = false;
@@ -809,6 +1050,9 @@
 	/* Receiver validation precedes all readiness setup and firmware access. */
 	if (ps4_uvd_token && (!ps4_uvd_poll_state || !ps4_token_descriptor_valid(rb)))
 		ps4_ready_park(adev, "TOKEN_DESCRIPTOR_OR_GATES", -EINVAL);
+	if (ps4_uvd_writeback && (!ps4_uvd_token || !ps4_uvd_poll_state ||
+	    !ps4_wb_descriptor_valid(rb, wb)))
+		ps4_ready_park(adev, "WRITEBACK_DESCRIPTOR_OR_GATES", -EINVAL);
 	ps4_ready_retained_cpu = r1_cpu;
 	ps4_ready_retained_pd = pd_addr;
 	if (!r1_cpu || backing_size != PS4_READY_BACKING_BYTES ||
@@ -958,6 +1202,9 @@
 					"PS4_UVD_READY CONVENTION_OBSERVED status=%08x mastint=%08x elapsed_us=%llu; fetch inhibited, IRQ semantics and execution unproved\n",
 					status, guard_sample.mastint, div_u64(elapsed, 1000));
 				ps4_ready_snapshot(adev, "ready_convention");
+				if (ps4_uvd_writeback)
+					ps4_wb_run(adev, rb, wb, pd_addr, cache_vmid_expected,
+						   baseline_fault, reset_count);
 				if (ps4_uvd_token)
 					ps4_token_run(adev, rb, pd_addr, cache_vmid_expected,
 						      baseline_fault, reset_count);
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_ps4_uvd_ready.h b/drivers/gpu/drm/amd/amdgpu/amdgpu_ps4_uvd_ready.h
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_ps4_uvd_ready.h
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_ps4_uvd_ready.h
@@ -13,6 +13,14 @@
 	u64 private_va;
 };
 
+/* First page of the separately owned retained UVD IB BO; no IB is submitted. */
+struct amdgpu_ps4_uvd_writeback {
+	void *cpu;
+	size_t bytes;
+	u64 private_va;
+};
+
+bool amdgpu_ps4_uvd_writeback_requested(void);
 bool amdgpu_ps4_uvd_token_requested(void);
 bool amdgpu_ps4_uvd_ready_requested(void);
 bool amdgpu_ps4_uvd_ready_enabled(struct amdgpu_device *adev);
@@ -23,6 +31,7 @@
 void amdgpu_ps4_uvd_ready_run(struct amdgpu_device *adev,
 				      void *r1_cpu, size_t backing_size,
 				      u64 pd_addr,
-				      const struct amdgpu_ps4_uvd_ring *rb);
+				      const struct amdgpu_ps4_uvd_ring *rb,
+				      const struct amdgpu_ps4_uvd_writeback *wb);
 
 #endif
