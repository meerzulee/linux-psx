# Local development build: 6.18-ps4-baikal plus native psx_mts_net autoload.
# Not a release target; it makes no support claim. See docs/ETHERNET-NATIVE.md.
TARGET_NAME="6.18-ps4-baikal-native-dev"
PLATFORM="ps4-baikal"
KERNEL_RELEASE="6.18.44-psx-ps4-baikal-native-dev1"
# kernel.org stable carries the same pinned v6.18.44 commit as gregkh/linux.
BASE_REPO="https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git"
BASE_REF="v6.18.44"
BASE_COMMIT="1efe5d048a391de3ead2804b2e7f86376c356cc5"
BASE_DEPTH=1
CONFIG_FILE="platforms/ps4/config/6.18-psx-baikal.config"
SERIES_FILE="platforms/ps4/patches/6.18-baikal-mts2/series-native-dev"
PATCHES_DIR="platforms/ps4/patches/6.18-baikal-mts2"
CONFIG_FRAGMENTS="platforms/ps4/config/fragments/mt7668.config platforms/ps4/config/fragments/usb-ethernet.config platforms/ps4/config/fragments/native-dev-release.config"
COMPILER="gcc"
SOURCE_DATE_EPOCH=1786233600
KBUILD_RELEASE_TIMESTAMP="2026-08-09 00:00:00 UTC"
KBUILD_RELEASE_USER="linux-psx"
KBUILD_RELEASE_HOST="builder"
KBUILD_RELEASE_VERSION=1
