# Development PS4 Baikal target on Linux 7.2.11: the 6.18-ps4-baikal series
# (54 patches and MTS2) ported to v7.2.11 with compile fixes. See
# docs/PORT-7.2.md and provenance/7.2-ps4-baikal.json.
#
# It compiles; it has not booted on any console. It is the first Linux 7.2
# boot candidate for Baikal, not the active target, and makes no support claim.
TARGET_NAME="7.2-ps4-baikal"
PLATFORM="ps4-baikal"
KERNEL_RELEASE="7.2.11-psx-ps4-baikal-dev1"
BASE_REPO="https://github.com/gregkh/linux.git"
BASE_REF="v7.2.11"
BASE_COMMIT="a2de78ee6ed8bf8cd99d177c74865a6e8c3cb6ea"
BASE_DEPTH=1
CONFIG_FILE="platforms/ps4/config/7.2-psx-baikal.config"
SERIES_FILE="platforms/ps4/patches/7.2-ps4-baikal/series"
PATCHES_DIR="platforms/ps4/patches/7.2-ps4-baikal"
CONFIG_FRAGMENTS="platforms/ps4/config/fragments/mt7668.config platforms/ps4/config/fragments/usb-ethernet.config"
COMPILER="gcc"
SOURCE_DATE_EPOCH=1792195200
KBUILD_RELEASE_TIMESTAMP="2026-10-17 00:00:00 UTC"
KBUILD_RELEASE_USER="linux-psx"
KBUILD_RELEASE_HOST="builder"
KBUILD_RELEASE_VERSION=1
