  "alpha_policy": {
    "assembly": "Exact dev6 kernel/config with all41 modules; only psx_mts_net.ko changes in the net1 experimental module variant.",
    "kernel_source": "Verified dev6 kernel, config and core source unchanged; one MTS C reclaim write omitted. Official external Kbuild with exact frozen headers; normal out-of-tree metadata retained. Complete corresponding source and all41 modules read back.",
    "qualification": "Experimental Baikal alpha; no stability promotion; no automatic power/storage/reset/rearm tests.",
    "uvd_lifecycle": "Explicit immutable ps4_uvd_poff opt-in retains backing for power-off or ordinary terminal restart after successful startup, including a subsequently failed or closed queue. No DMA drain/reset/unload/rearm.",
    "optional_providers": "First power candidate omits optional Wayland and Chromium provider rebinding; older provider identities remain separate.",
    "firmware": "Retain alpha3 corrected314168-byte external runtime firmware in root and initramfs. No public firmware distribution.",
    "sata": "Only Sony104d:90de at PCI0000:00:14.7/ATA hardware-local port0; 5ms scoped completion, old poll0, PHYorbit1 and1.5Gbps with NCQ. Init makes only that internal disk and its partitions read-only before userspace; no internal mounts or writes.",
    "clock": "Host epoch remains in bootargs; nonblocking root controller Wants=systemd-timesyncd.service replaces the long kernel command-line wants token.",
    "lifecycle_lineage": "Preserve dev5 policy separately; power-off semantics unchanged, terminal restart admits post-start failure with completed-hw-init guard.",
    "power": "Confirmed immediate action cancels owned workers, kills fixed graphical cgroups, skips pending report and service-stop waits, and calls ordinary Linux reboot(). Unsaved writes may be lost; hardware outcome requires observation.",
    "ethernet": "Hypothesis-only preserve returned TX descriptor word0 until complete producer replacement; sentinel, buffers, polling, ownership and lifecycle unchanged. Fresh bounded network test required; no stability acceptance inherited."
  },
