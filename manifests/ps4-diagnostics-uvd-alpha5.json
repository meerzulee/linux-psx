  "alpha_policy": {
    "assembly": "Offline derivative of the exact ordinary native3 ext4 root, corrected314168-byte firmware and complete matched runtime-dev4 modules. Fresh package hashes required.",
    "kernel_source": "Frozen runtime-dev3 with only the reviewed scoped Baikal AHCI completion patch; UVD and ICC sources unchanged from dev3. Full source and matching modules preserved.",
    "qualification": "Experimental Baikal alpha; no stability promotion; no automatic power/storage/reset/rearm tests.",
    "uvd_lifecycle": "Experimental opt-in amdgpu.ps4_uvd_poff=1 permits only SYSTEM_POWER_OFF while retaining DMA; reboot, suspend, remove and reset guards remain unchanged. No generic UI power controls or qualification claim.",
    "optional_providers": "Separate alpha5 Chromium and native Wayland contracts; all provider executable/license bytes retained. Older profile/root bindings remain separate.",
    "firmware": "Retain alpha3 corrected314168-byte external runtime firmware in root and initramfs. No public firmware distribution.",
    "sata": "Only Sony104d:90de at PCI0000:00:14.7/ATA hardware-local port0; 5ms scoped completion, old poll0, PHYorbit1 and1.5Gbps with NCQ. Init makes only that internal disk and its partitions read-only before userspace; no internal mounts or writes.",
    "clock": "Host epoch remains in bootargs; nonblocking root controller Wants=systemd-timesyncd.service replaces the long kernel command-line wants token.",
    "lifecycle_lineage": "uvd_lifecycle_sources_unchanged=false preserves the historical dev2-to-dev3 power-off adaptation; uvd_sources_unchanged_from_dev3=true describes this SATA-only derivative."
  },
