#!/usr/bin/env python3
"""Verify the frozen PS4 import and the active distribution-independent target."""
import hashlib
import json
from pathlib import Path
import re
import shlex

ROOT = Path(__file__).resolve().parents[1]


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def checked_file(name, expected):
    path = (ROOT / name).resolve()
    if not path.is_relative_to(ROOT) or not path.is_file() or sha(path) != expected:
        raise ValueError(f"provenance checksum mismatch: {name}")


def read_env(name):
    env = {}
    for line in (ROOT / f"targets/{name}.env").read_text().splitlines():
        if re.match(r"^[A-Z_]+=", line):
            key, value = line.split("=", 1)
            env[key] = shlex.split(value)[0]
    return env


def main():
    count = 0
    for line in (ROOT / "provenance/ps4-SHA256SUMS").read_text().splitlines():
        checksum, name = line.split("  ", 1)
        checked_file(name, checksum)
        count += 1
    target = json.loads((ROOT / "provenance/6.18-ps4-baikal.json").read_text())
    for item in target["inputs"] + target["patches"]:
        checked_file(item["path"], item["sha256"])
    series = ROOT / target["series_path"]
    entries = [line.strip() for line in series.read_text().splitlines() if line.strip() and not line.lstrip().startswith("#")]
    if sha(series) != target["series_sha256"] or entries != [item["entry"] for item in target["patches"]]:
        raise ValueError("active series/order mismatch")
    for entry, patch in zip(entries, target["patches"]):
        if (series.parent / entry).resolve() != ROOT / patch["path"]:
            raise ValueError("active patch resolution mismatch")
    ordered = "".join(f"{item['sha256']}  {item['entry']}\n" for item in target["patches"])
    if hashlib.sha256(ordered.encode()).hexdigest() != target["ordered_patchset_sha256"]:
        raise ValueError("ordered patch-set mismatch")
    baseline = json.loads((ROOT / "provenance/ps4-import.json").read_text())["series"][0]["patches"]
    additions = {item["path"]: item["sha256"] for item in target["psx_additions"]}
    if ([item["sha256"] for item in target["patches"][:54]] != [item["sha256"] for item in baseline]
            or len(entries) != target["active_patch_count"] or len(entries) != 56
            or target["patches"][54]["sha256"] != target["direct_imports"][0]["sha256"]
            or additions.get(target["patches"][55]["path"]) != target["patches"][55]["sha256"]):
        raise ValueError("active series must preserve the 54-patch base, MTS2 and native autoload")
    env = read_env(target["target"])
    expected = {"TARGET_NAME": target["target"], "PLATFORM": target["platform"],
                "KERNEL_RELEASE": target["kernel_release"], "BASE_REPO": target["upstream"]["repository"],
                "BASE_REF": target["upstream"]["ref"], "BASE_COMMIT": target["upstream"]["commit"],
                "SERIES_FILE": target["series_path"]}
    if any(env.get(key) != value for key, value in expected.items()):
        raise ValueError("target definition differs from structured provenance")
    knowledge = json.loads((ROOT / "provenance/knowledge-migration.json").read_text())
    if knowledge["schema"] != 1 or not re.fullmatch(r"[0-9a-f]{40}", knowledge["source"]["commit"]):
        raise ValueError("historical knowledge must have an immutable source pin")
    for item in knowledge["curated_outputs"]:
        checked_file(item["path"], item["sha256"])
    if len(knowledge["files"]) != knowledge["scope"]["file_count"]:
        raise ValueError("historical knowledge coverage count differs")
    rmux_count = check_rmux_import()
    port_count = check_port_target()
    baikal_count, baikal_unchanged = check_baikal_port_target()
    print(f"PASS: {count} frozen checksums, {len(entries)} active patches and "
          f"{len(knowledge['curated_outputs'])} curated knowledge/test hashes; pins match")
    print(f"PASS: {rmux_count} rmux import checksums; series order and pins match")
    print(f"PASS: 7.2-ps4 development series: {port_count} patches; rmux sources and pins match")
    print(f"PASS: 7.2-ps4-baikal development series: {baikal_count} patches, "
          f"{baikal_unchanged} unchanged 6.18 files; sources and pins match")


def check_rmux_import():
    """Verify the generated rmux source imports (see docs/RMUX-IMPORT.md)."""
    sums = ROOT / "provenance/rmux-SHA256SUMS"
    count = 0
    for line in sums.read_text().splitlines():
        checksum, name = line.split("  ", 1)
        checked_file(name, checksum)
        count += 1
    manifest = json.loads((ROOT / "provenance/rmux-import.json").read_text())
    for imp in manifest["imports"]:
        series = ROOT / imp["dir"] / "series"
        entries = [line for line in series.read_text().splitlines() if line.strip()]
        if sha(series) != imp["series_sha256"] or entries != [p["entry"] for p in imp["patches"]]:
            raise ValueError(f"rmux import series/order mismatch: {imp['name']}")
        ordered = "".join(f"{p['sha256']}  {p['entry']}\n" for p in imp["patches"])
        if hashlib.sha256(ordered.encode()).hexdigest() != imp["ordered_patchset_sha256"]:
            raise ValueError(f"rmux import ordered patch-set mismatch: {imp['name']}")
        pins = [imp["base"]["commit"]] + [x for seg in imp["segments"] for x in (seg["from"], seg["to"])]
        if not all(re.fullmatch(r"[0-9a-f]{40}", pin) for pin in pins):
            raise ValueError(f"rmux import must pin full commits: {imp['name']}")
        if any(not re.fullmatch(r"[0-9a-f]{40}", p["commit"]) for p in imp["patches"]):
            raise ValueError(f"rmux import patch lacks a source commit: {imp['name']}")
    for env in list((ROOT / "targets").glob("*.env")) + list((ROOT / "platforms/ps4/targets").glob("*.env")):
        if "rmux-reference" in env.read_text():
            raise ValueError(f"target must not use rmux reference configs: {env.name}")
    return count


def check_dev_series(name):
    """Verify a development target's patches, series order, inputs and definition."""
    target = json.loads((ROOT / f"provenance/{name}.json").read_text())
    items = target["patches"] + target.get("direct_references", [])
    for item in target["inputs"] + items:
        checked_file(item["path"], item["sha256"])
    series = ROOT / target["series_path"]
    entries = [line.strip() for line in series.read_text().splitlines() if line.strip() and not line.lstrip().startswith("#")]
    if (sha(series) != target["series_sha256"] or entries != [item["entry"] for item in items]
            or len(entries) != target["active_patch_count"]):
        raise ValueError(f"{name} series/order mismatch")
    for entry, item in zip(entries, items):
        if (series.parent / entry).resolve() != ROOT / item["path"]:
            raise ValueError(f"{name} patch resolution mismatch")
    ordered = "".join(f"{item['sha256']}  {item['entry']}\n" for item in items)
    if hashlib.sha256(ordered.encode()).hexdigest() != target["ordered_patchset_sha256"]:
        raise ValueError(f"{name} ordered patch-set mismatch")
    env = read_env(target["target"])
    expected = {"TARGET_NAME": target["target"], "PLATFORM": target["platform"],
                "KERNEL_RELEASE": target["kernel_release"], "BASE_REPO": target["upstream"]["repository"],
                "BASE_REF": target["upstream"]["ref"], "BASE_COMMIT": target["upstream"]["commit"],
                "SERIES_FILE": target["series_path"], "SOURCE_DATE_EPOCH": str(target["source_date_epoch"])}
    if any(env.get(key) != value for key, value in expected.items()):
        raise ValueError(f"{name} target definition differs from structured provenance")
    if 'CONFIG_EXTRA_FIRMWARE=""' not in (ROOT / env["CONFIG_FILE"]).read_text().splitlines():
        raise ValueError(f"{name} config must not embed device firmware")
    return target, entries


def check_port_target():
    """Verify the 7.2-ps4 development target against its structured provenance."""
    target, entries = check_dev_series("7.2-ps4")
    imports = json.loads((ROOT / target["rmux_import"]["manifest"]).read_text())["imports"]
    source = next(imp for imp in imports if imp["name"] == target["rmux_import"]["import"])
    by_entry = {p["entry"]: p for p in source["patches"]}
    for p in target["patches"]:
        if p["origin"] == source["name"]:
            src = by_entry.get(p["rmux_entry"])
            if not src or src["commit"] != p["rmux_commit"] or src["sha256"] != p["rmux_sha256"]:
                raise ValueError(f"7.2-ps4 patch does not match its rmux source: {p['entry']}")
            if p["change"] == "adapted" and not p.get("note"):
                raise ValueError(f"7.2-ps4 adaptation lacks a recorded resolution: {p['entry']}")
        elif p["origin"] != "port-fix":
            raise ValueError(f"7.2-ps4 patch has an unknown origin: {p['entry']}")
    return len(entries)


def check_baikal_port_target():
    """Verify the 7.2-ps4-baikal target against the 6.18-ps4-baikal series it ports."""
    target, entries = check_dev_series("7.2-ps4-baikal")
    pin = target["source_target"]
    source = json.loads((ROOT / pin["provenance"]).read_text())
    # The pin covers the 6.18 patches that were ported; later 6.18 additions are not.
    count = sum(p["origin"] == source["target"] for p in target["patches"])
    base = source["patches"][:count]
    ordered = "".join(f"{p['sha256']}  {p['entry']}\n" for p in base)
    if source["target"] != pin["target"] or hashlib.sha256(ordered.encode()).hexdigest() != pin["ordered_patchset_sha256"]:
        raise ValueError("7.2-ps4-baikal source target pin differs")
    ported, fixes = target["patches"][:count], target["patches"][count:]
    for p, src in zip(ported, base):
        if (p["origin"] != source["target"] or p["source_path"] != src["path"]
                or p["source_sha256"] != src["sha256"]):
            raise ValueError(f"7.2-ps4-baikal patch does not match its 6.18 source: {p['entry']}")
        if p["change"] == "unchanged":
            if p["path"] != src["path"] or p["sha256"] != src["sha256"]:
                raise ValueError(f"7.2-ps4-baikal unchanged patch is not the 6.18 file: {p['entry']}")
        elif p["change"] not in ("context", "adapted") or (p["change"] == "adapted" and not p.get("note")):
            raise ValueError(f"7.2-ps4-baikal regeneration lacks a recorded resolution: {p['entry']}")
    if len(ported) != count or any(p["origin"] != "port-fix" or not p.get("note") for p in fixes):
        raise ValueError("7.2-ps4-baikal must port the pinned 6.18 series, then recorded port fixes")
    return len(entries), sum(p["change"] == "unchanged" for p in ported)

if __name__ == "__main__":
    main()
