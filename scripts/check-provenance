#!/usr/bin/env python3
"""Verify the frozen PS4 import and the active distribution-independent target."""
import hashlib
import json
from pathlib import Path
import re
import shlex

ROOT = Path(__file__).resolve().parents[1]


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def checked_file(name, expected):
    path = (ROOT / name).resolve()
    if not path.is_relative_to(ROOT) or not path.is_file() or sha(path) != expected:
        raise ValueError(f"provenance checksum mismatch: {name}")


def main():
    count = 0
    for line in (ROOT / "provenance/ps4-SHA256SUMS").read_text().splitlines():
        checksum, name = line.split("  ", 1)
        checked_file(name, checksum)
        count += 1
    target = json.loads((ROOT / "provenance/6.18-ps4-baikal.json").read_text())
    for item in target["inputs"] + target["patches"]:
        checked_file(item["path"], item["sha256"])
    series = ROOT / target["series_path"]
    entries = [line.strip() for line in series.read_text().splitlines() if line.strip() and not line.lstrip().startswith("#")]
    if sha(series) != target["series_sha256"] or entries != [item["entry"] for item in target["patches"]]:
        raise ValueError("active series/order mismatch")
    for entry, patch in zip(entries, target["patches"]):
        if (series.parent / entry).resolve() != ROOT / patch["path"]:
            raise ValueError("active patch resolution mismatch")
    ordered = "".join(f"{item['sha256']}  {item['entry']}\n" for item in target["patches"])
    if hashlib.sha256(ordered.encode()).hexdigest() != target["ordered_patchset_sha256"]:
        raise ValueError("ordered patch-set mismatch")
    baseline = json.loads((ROOT / "provenance/ps4-import.json").read_text())["series"][0]["patches"]
    if ([item["sha256"] for item in target["patches"][:-1]] != [item["sha256"] for item in baseline]
            or len(entries) != target["active_patch_count"] or len(entries) != 55):
        raise ValueError("active series must preserve the 54-patch base plus MTS2")
    env = {}
    for line in (ROOT / f"targets/{target['target']}.env").read_text().splitlines():
        if re.match(r"^[A-Z_]+=", line):
            key, value = line.split("=", 1)
            env[key] = shlex.split(value)[0]
    expected = {"TARGET_NAME": target["target"], "PLATFORM": target["platform"],
                "KERNEL_RELEASE": target["kernel_release"], "BASE_REPO": target["upstream"]["repository"],
                "BASE_REF": target["upstream"]["ref"], "BASE_COMMIT": target["upstream"]["commit"],
                "SERIES_FILE": target["series_path"]}
    if any(env.get(key) != value for key, value in expected.items()):
        raise ValueError("target definition differs from structured provenance")
    knowledge = json.loads((ROOT / "provenance/knowledge-migration.json").read_text())
    if knowledge["schema"] != 1 or not re.fullmatch(r"[0-9a-f]{40}", knowledge["source"]["commit"]):
        raise ValueError("historical knowledge must have an immutable source pin")
    for item in knowledge["curated_outputs"]:
        checked_file(item["path"], item["sha256"])
    if len(knowledge["files"]) != knowledge["scope"]["file_count"]:
        raise ValueError("historical knowledge coverage count differs")
    rmux_count = check_rmux_import()
    print(f"PASS: {count} frozen checksums, {len(entries)} active patches and "
          f"{len(knowledge['curated_outputs'])} curated knowledge/test hashes; pins match")
    print(f"PASS: {rmux_count} rmux import checksums; series order and pins match")


def check_rmux_import():
    """Verify the generated rmux source imports (see docs/RMUX-IMPORT.md)."""
    sums = ROOT / "provenance/rmux-SHA256SUMS"
    count = 0
    for line in sums.read_text().splitlines():
        checksum, name = line.split("  ", 1)
        checked_file(name, checksum)
        count += 1
    manifest = json.loads((ROOT / "provenance/rmux-import.json").read_text())
    for imp in manifest["imports"]:
        series = ROOT / imp["dir"] / "series"
        entries = [line for line in series.read_text().splitlines() if line.strip()]
        if sha(series) != imp["series_sha256"] or entries != [p["entry"] for p in imp["patches"]]:
            raise ValueError(f"rmux import series/order mismatch: {imp['name']}")
        ordered = "".join(f"{p['sha256']}  {p['entry']}\n" for p in imp["patches"])
        if hashlib.sha256(ordered.encode()).hexdigest() != imp["ordered_patchset_sha256"]:
            raise ValueError(f"rmux import ordered patch-set mismatch: {imp['name']}")
        pins = [imp["base"]["commit"]] + [x for seg in imp["segments"] for x in (seg["from"], seg["to"])]
        if not all(re.fullmatch(r"[0-9a-f]{40}", pin) for pin in pins):
            raise ValueError(f"rmux import must pin full commits: {imp['name']}")
        if any(not re.fullmatch(r"[0-9a-f]{40}", p["commit"]) for p in imp["patches"]):
            raise ValueError(f"rmux import patch lacks a source commit: {imp['name']}")
    return count


if __name__ == "__main__":
    main()
