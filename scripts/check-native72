#!/usr/bin/env python3
"""Verify the frozen native 7.2 base, HDMI addition and platform defaults."""
import hashlib
import json
from pathlib import Path
import shlex

ROOT = Path(__file__).resolve().parents[1]
TARGET = "7.2-ps4-baikal-native-dev"
RELEASE = "7.2.11-psx-ps4-baikal-native-dev4"
SERIES = "edd6283acfe102422bc9f4bc4de22f562e7c55e23bc8ae3c5d78e8d271935d46"
PATCHSET = "4c578be6a10fc794d70dabd2ab3ce3c0e866aaa9b925c81014f37d55d392f9d9"
NATIVE = "e6e799c9d82618f1c92abfaa801cb49613feb4d4f4f033bdd79e5d5f3a0ee9b3"
UNDERSCAN = "e6cb81ca268b02dcbaccec2f13a63e82015f838942d8dd30ffafe5fa0168930c"


def require(condition, message):
    if not condition:
        raise ValueError(message)


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def read_env(root, name):
    values = {}
    for line in (root / f"targets/{name}.env").read_text().splitlines():
        if line and line[0].isupper() and "=" in line:
            key, value = line.split("=", 1)
            values[key] = shlex.split(value)[0]
    return values


def check_target(root=ROOT):
    root = root.resolve()
    record = json.loads((root / f"provenance/{TARGET}.json").read_text())
    base = json.loads((root / "provenance/7.2-ps4-baikal.json").read_text())
    env, base_env = read_env(root, TARGET), read_env(root, "7.2-ps4-baikal")
    expected = dict(base_env, TARGET_NAME=TARGET, KERNEL_RELEASE=RELEASE,
                    CONFIG_FILE="platforms/ps4/config/7.2-psx-baikal-native-dev.config",
                    SERIES_FILE=f"platforms/ps4/patches/{TARGET}/series")
    require(env == expected, "native 7.2 target must preserve every base build assignment except identity/config/series")
    require(env["BASE_REPO"] == "https://github.com/gregkh/linux.git" and env["BASE_REF"] == "v7.2.11"
            and env["BASE_COMMIT"] == "a2de78ee6ed8bf8cd99d177c74865a6e8c3cb6ea"
            and env["SOURCE_DATE_EPOCH"] == "1792195200", "native 7.2 tested upstream identity differs")
    require(record["target"] == TARGET and record["kernel_release"] == RELEASE
            and record["upstream"] == base["upstream"] and record["platform"] == base["platform"]
            and record["source_date_epoch"] == base["source_date_epoch"], "native 7.2 provenance identity differs")
    require(record["series_path"] == env["SERIES_FILE"] and record["patches_dir"] == env["PATCHES_DIR"],
            "native 7.2 patch root differs from the builder")
    pin = record["base_target"]
    require(pin == {"target": base["target"], "provenance": "provenance/7.2-ps4-baikal.json",
                    "kernel_release": base["kernel_release"], "series_path": base["series_path"],
                    "series_sha256": base["series_sha256"], "active_patch_count": 63,
                    "ordered_patchset_sha256": base["ordered_patchset_sha256"]}, "native 7.2 base target pin differs")
    patches = record["patches"]
    require(len(patches) == record["active_patch_count"] == 74 and len(base["patches"]) == 63,
            "native 7.2 requires exactly 63 base patches, native autoload, underscan and nine focused additions")
    require(all({k: item[k] for k in ("entry", "path", "sha256")} ==
                    {k: prefix[k] for k in ("entry", "path", "sha256")}
                for item, prefix in zip(base["patches"], patches[:63])), "native 7.2 canonical prefix differs")
    require(digest(root / base["series_path"]) == base["series_sha256"], "native 7.2 base series differs")
    for item in record["inputs"] + patches:
        path = (root / item["path"]).resolve()
        require(path.is_relative_to(root) and path.is_file() and digest(path) == item["sha256"],
                "native 7.2 input checksum differs: " + item["path"])
    series = root / record["series_path"]
    entries = [line.strip() for line in series.read_text().splitlines() if line.strip() and not line.lstrip().startswith("#")]
    require(digest(series) == record["series_sha256"] == SERIES and entries == [p["entry"] for p in patches],
            "native 7.2 tested series/order differs")
    require(all((root / env["PATCHES_DIR"] / p["entry"]).resolve() == root / p["path"] for p in patches),
            "native 7.2 patch path differs from the builder")
    ordered = "".join(f"{p['sha256']}  {p['entry']}\n" for p in patches)
    require(hashlib.sha256(ordered.encode()).hexdigest() == record["ordered_patchset_sha256"] == PATCHSET,
            "native 7.2 tested patchset differs")
    native = record["native_autoload"]
    source = json.loads((root / "provenance/6.18-ps4-baikal.json").read_text())
    require(patches[63]["path"] == native["path"] == "platforms/ps4/patches/6.18-baikal-mts2/0700-network-mts/0002-net-ps4-mts-native-autoload.patch"
            and patches[63]["sha256"] == native["sha256"] == NATIVE
            and any(p["path"] == native["path"] and p["sha256"] == NATIVE for p in source["patches"]),
            "native 7.2 autoload patch must remain the unchanged 6.18 addition")
    additions = record["psx_additions"]
    require(len(additions) == 10
            and patches[64]["path"] == additions[0]["path"] ==
                "platforms/ps4/patches/6.18-baikal-mts2/0300-gpu-liverpool/0001-amdgpu-ps4-bridge-honour-underscan-properties.patch"
            and patches[64]["sha256"] == additions[0]["sha256"] == UNDERSCAN
            and additions[0]["source_merge_commit"] == "377f1107332199a21ceca1fd8f1fe7a2b01c263f"
            and any(p["path"] == patches[64]["path"] and p["sha256"] == UNDERSCAN
                    for p in source["patches"]),
            "native 7.2 underscan must remain the exact reviewed PR #3 patch")
    require(patches[65]["path"] == additions[1]["path"] ==
                "platforms/ps4/patches/7.2-ps4-baikal/0100-x86-platform/0001-ps4-default-platform-boot-policy.patch"
            and patches[65]["sha256"] == additions[1]["sha256"]
            and additions[1]["source_issue"] == "https://github.com/meerzulee/linux-psx/issues/8",
            "native 7.2 platform defaults must be recorded separately from imported patches")
    local_entries = [
        "0200-ps4-drivers/0002-ps4-icc-unlock-not-ready-command.patch",
        "0100-x86-platform/0002-ps4-bound-emc-calibration-waits.patch",
        "0300-gpu-liverpool/0037-amdgpu-ps4-connector-cleanup.patch",
        "0200-ps4-drivers/0003-ps4-initialize-unregistered-uart-slots.patch",
        "0500-network-mt7668/0001-mt76x8-bound-config-command-inputs.patch",
        "0300-gpu-liverpool/0038-amdgpu-ps4-program-audio-dto.patch",
        "0200-ps4-drivers/0001-ps4-bpcie-icc-power-off-before-acpi.patch",
        "0200-ps4-drivers/0004-ps4-bpcie-icc-atomic-restart.patch",
    ]
    for index, entry in enumerate(local_entries, 66):
        require(patches[index]["path"] == additions[index - 64]["path"] ==
                    "platforms/ps4/patches/7.2-ps4-baikal/" + entry
                and patches[index]["sha256"] == additions[index - 64]["sha256"],
                "native 7.2 focused platform fix is missing its separate provenance")
    audio = additions[-3]
    require(audio["source_issue"] == "https://github.com/meerzulee/linux-psx/issues/6"
            and audio["source_path"] == "platforms/ps4/patches/7.2-ps4/0175-drm-amdgpu-ps4-program-audio-dto.patch"
            and audio["source_commit"] == "ec926348cdd188fdffbbf7d3a930185004084894"
            and digest(root / audio["source_path"]) == audio["source_sha256"] ==
                "4691ee521b13ebc3cd7f88f6d2ffe5264127a053a528234cfbb1846a44a01352",
            "native 7.2 audio adaptation must preserve the original psX source identity")
    poweroff = additions[-2]
    require(poweroff["author"] == "suds-mcduff"
            and poweroff["source_pull_request"] == "https://github.com/meerzulee/linux-psx/pull/4"
            and poweroff["source_commit"] == "16c43fcd090c95669374c27cbb2df835326d259a"
            and poweroff["sha256"] == "cb01d71ad7e12144ee7f014fe5385e37f7e239b2f2f3ee065b5ec7e0a0de219a",
            "native 7.2 power-off must retain the guarded contributor patch and original authorship")
    original = (root / base_env["CONFIG_FILE"]).read_bytes()
    expected_config = original.replace(b'CONFIG_LOCALVERSION="-psx-ps4-baikal-dev1"',
                                       b'CONFIG_LOCALVERSION="-psx-ps4-baikal-native-dev4"')
    require(original != expected_config and (root / env["CONFIG_FILE"]).read_bytes() == expected_config,
            "native 7.2 config changes beyond LOCALVERSION")
    require(record["firmware"] == {"embedded": False, "bundled": False}
            and b'CONFIG_EXTRA_FIRMWARE=""\n' in expected_config, "native 7.2 must remain firmware-free")
    require(record["hardware_evidence"]["experiment"] == "EXP-20261018-004"
            and record["hardware_evidence"]["kernel_release"] == "7.2.11-psx-ps4-baikal-native-dev1"
            and record["hardware_evidence"]["uart_continuity"] == "completed",
            "native 7.2 must keep completed dev1 evidence separate from dev3")
    return len(patches)


if __name__ == "__main__":
    print(f"PASS: native 7.2 Baikal: {check_target()} exact patches; base config, build assignments and evidence pins match")
