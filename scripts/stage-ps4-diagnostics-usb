#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Copy a verified diagnostic boot set to one identified, mounted FAT32 USB.

No partitioning, formatting, raw-device writes, payload delivery or console
operation. Default is a concrete read-only plan; --apply copies regular files.
"""
from __future__ import annotations

import argparse
from contextlib import contextmanager
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import shutil
import stat
import subprocess
import tempfile
import time


def digest(path):
    h = hashlib.sha256()
    with path.open("rb") as stream:
        while chunk := stream.read(1024 * 1024):
            h.update(chunk)
    return h.hexdigest()


def safe_name(value):
    if not isinstance(value, str) or any(c in value for c in "\r\n\x00"):
        raise ValueError("unsafe boot-set member")
    p = PurePosixPath(value)
    if p.is_absolute() or ".." in p.parts or str(p) in (".", ""):
        raise ValueError("unsafe boot-set member")
    return str(p)


def source_files(source):
    result = {}
    for line in (source / "SHA256SUMS").read_text().splitlines():
        pin, name = line.split(None, 1)
        name = safe_name(name.lstrip(" *"))
        if name not in ("bzImage", "initramfs.cpio.gz", "bootargs.template.txt", "vram.txt") and not name.startswith("psx-diagnostics/"):
            raise ValueError("unexpected loader-facing source file")
        if (name in ("psx-diagnostics/installed.json", "psx-diagnostics/USB-SHA256SUMS")
                or name.startswith(("psx-diagnostics/results/", "psx-diagnostics/backups/", "psx-diagnostics/state/"))):
            raise ValueError("source contains reserved diagnostic USB state")
        if not re.fullmatch(r"[a-f0-9]{64}", pin) or name in result:
            raise ValueError("invalid/duplicate source checksum")
        path = source / name
        if path.is_symlink() or not path.is_file() or not path.resolve().is_relative_to(source):
            raise ValueError("boot-set input is not a contained regular file")
        if path.stat().st_size >= 4 * 1024 ** 3 or digest(path) != pin:
            raise ValueError("boot-set input exceeds FAT32 limit or differs from its pin")
        result[name] = pin
    meta_path = source / "psx-diagnostics/boot-set.json"
    if meta_path.is_symlink() or not meta_path.is_file() or not meta_path.resolve().is_relative_to(source):
        raise ValueError("boot-set receipt is not a contained regular file")
    meta = json.loads(meta_path.read_text())
    root_file = meta.get("rootfs_file", "psx-diagnostics/rootfs.tar.gz")
    if root_file not in ("psx-diagnostics/rootfs.tar.gz", "psx-diagnostics/rootfs.ext4"):
        raise ValueError("unsupported diagnostic root image path")
    if ((meta.get("root_format") == "ext4-ro-loop") != (root_file == "psx-diagnostics/rootfs.ext4")):
        raise ValueError("root image format/path mismatch")
    required = {"bzImage", "initramfs.cpio.gz", "bootargs.template.txt", "vram.txt",
                root_file, "psx-diagnostics/boot-set.json"}
    if not required.issubset(result):
        raise ValueError("incomplete diagnostic boot set")
    for name, key in (("bzImage", "kernel_sha256"), ("initramfs.cpio.gz", "initramfs_sha256"),
                      (root_file, "rootfs_sha256")):
        if result[name] != meta[key]:
            raise ValueError("boot-set receipt disagrees with files")
    if meta.get("hardware_acceptance") is not False:
        raise ValueError("development diagnostic boot set must not claim hardware acceptance")
    if (source / "vram.txt").read_text() != str(meta["vram_mib"]) + "\n":
        raise ValueError("VRAM loader profile disagrees with the boot receipt")
    budget = meta.get("maximum_boot_set_bytes")
    if budget is not None and (type(budget) is not int or budget <= 0
            or sum((source / name).stat().st_size for name in result) + (source / "SHA256SUMS").stat().st_size > budget):
        raise ValueError("boot set exceeds its declared size limit")
    return result, meta


def validate_description(disk, expected_serial, expected_bytes, mountpoint):
    if (disk.get("type") != "disk" or disk.get("tran") != "usb"
            or not disk.get("rm") or disk.get("serial") != expected_serial
            or disk.get("size") != expected_bytes):
        raise ValueError("USB transport/type/serial/capacity differs from the selected device")
    children = disk.get("children", [])
    if len(children) != 1:
        raise ValueError("expected the existing single diagnostic FAT32 partition")
    part = children[0]
    if (part.get("type") != "part" or part.get("fstype") != "vfat"
            or str(mountpoint) not in (part.get("mountpoints") or [])
            or not re.fullmatch(r"[a-fA-F0-9]{4}-[a-fA-F0-9]{4}", part.get("uuid") or "")):
        raise ValueError("mounted FAT32 partition identity differs")
    return part


def inspect(args):
    device = args.device
    if device.parent != Path("/dev/disk/by-id") or not device.name.startswith("usb-") or "-part" in device.name:
        raise ValueError("select the complete USB by its stable /dev/disk/by-id/usb- identity")
    actual = device.resolve(strict=True)
    if not stat.S_ISBLK(actual.stat().st_mode):
        raise ValueError("selected by-id target is not a block device")
    data = json.loads(subprocess.check_output([
        "lsblk", "--json", "--bytes", "--tree", "--output",
        "PATH,TYPE,SIZE,MODEL,SERIAL,TRAN,RM,FSTYPE,LABEL,UUID,MOUNTPOINTS", str(device)], text=True))
    if len(data["blockdevices"]) != 1:
        raise ValueError("ambiguous USB identity")
    disk = data["blockdevices"][0]
    mountpoint = args.mountpoint.resolve(strict=True)
    part = validate_description(disk, args.expect_serial, args.expect_bytes, mountpoint)
    mounted = json.loads(subprocess.check_output(["findmnt", "--json", "--target", str(mountpoint)], text=True))["filesystems"]
    if len(mounted) != 1:
        raise ValueError("ambiguous mount")
    mount = mounted[0]
    if (Path(mount["target"]).resolve() != mountpoint or mount["fstype"] != "vfat"
            or "rw" not in mount["options"].split(",")
            or Path(mount["source"]).resolve() != Path(part["path"]).resolve()
            or Path(disk["path"]).resolve() != actual):
        raise ValueError("live mount does not belong to the selected USB")
    return mountpoint, {"device": str(device), "path": str(actual), "serial": disk["serial"],
                        "model": disk["model"], "bytes": disk["size"], "partition": part["path"],
                        "uuid": part["uuid"], "mountpoint": str(mountpoint)}


def atomic_write(target, source=None, data=None):
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=".psx-copy-", dir=target.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            if source is not None:
                with source.open("rb") as incoming:
                    shutil.copyfileobj(incoming, stream, length=1024 * 1024)
            else:
                stream.write(data)
            stream.flush(); os.fsync(stream.fileno())
        os.replace(name, target)
    finally:
        Path(name).unlink(missing_ok=True)


@contextmanager
def pinned_mount(mountpoint, partition_device):
    """Keep every relative write on this filesystem even if its mount is detached."""
    directory = os.open(mountpoint, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    previous = os.open(".", os.O_RDONLY | os.O_DIRECTORY)
    try:
        if os.fstat(directory).st_dev != partition_device:
            raise ValueError("opened mount does not belong to the selected partition")
        os.fchdir(directory)
        yield
    finally:
        os.fchdir(previous)
        os.close(previous)
        os.close(directory)


def installed_sums(files):
    return "".join(f"{pin}  {name}\n" for name, pin in sorted(files.items()))


def render_bootargs(template, usb_uuid, metadata, epoch=None):
    if template.count("@USB_UUID@") != 1:
        raise ValueError("bootargs must bind exactly one selected USB UUID")
    arguments = template.replace("@USB_UUID@", usb_uuid)
    if metadata.get("ui_backend") == "ratatui":
        epoch = int(time.time()) if epoch is None else epoch
        if type(epoch) is not int or not 1577836800 <= epoch < 4102444800:
            raise ValueError("diagnostic clock seed must be a valid 2020–2099 epoch")
        tokens = [token for token in arguments.split() if not token.startswith("time=")]
        ntp = "systemd.wants=systemd-timesyncd.service"
        clock_want = metadata.get("boot_clock_start_timesyncd", True)
        if type(clock_want) is not bool:
            raise ValueError("boot clock service policy must be boolean")
        if not clock_want and metadata.get("profile") != "ps4-baikal-diagnostics-uvd-alpha5":
            raise ValueError("only the scoped SATA alpha5 starts time sync through its root service")
        if not clock_want:
            tokens = [token for token in tokens if token != ntp]
        elif ntp not in tokens:
            tokens.append(ntp)
        tokens.append("time=" + str(epoch))
        arguments = " ".join(tokens) + "\n"
    return arguments.encode()


def previous_install(mountpoint, device):
    receipt = mountpoint / "psx-diagnostics/installed.json"
    sums = mountpoint / "psx-diagnostics/USB-SHA256SUMS"
    if not receipt.exists():
        if sums.exists():
            raise ValueError("refusing an unowned USB-SHA256SUMS file")
        return None
    previous = json.loads(receipt.read_text())
    if (previous.get("owner") != "psx-diagnostics-usb-v1"
            or previous.get("verified_readback") is not True
            or previous.get("hardware_acceptance") is not False
            or any(previous.get("target", {}).get(key) != device[key] for key in ("serial", "bytes", "uuid"))
            or not isinstance(previous.get("files"), dict)):
        raise ValueError("existing install receipt does not own this diagnostic USB")
    for name, pin in previous["files"].items():
        if (safe_name(name) != name or not re.fullmatch(r"[a-f0-9]{64}", pin)
                or (name not in ("bzImage", "initramfs.cpio.gz", "bootargs.txt", "vram.txt")
                    and not name.startswith("psx-diagnostics/"))):
            raise ValueError("invalid previous ownership record")
    if not sums.is_file() or sums.read_text() != installed_sums(previous["files"]):
        raise ValueError("previous generated checksum file differs from its owned receipt")
    return previous


def copy_boot_set(source, files, bootargs, previous, plan, expected_names):
    # All destinations are relative to pinned_mount's held filesystem directory.
    mountpoint = Path(".")
    backup = mountpoint / "psx-diagnostics/backups" / str(time.time_ns())
    if previous:
        backup.mkdir(parents=True, exist_ok=False)
        for name in expected_names | {"psx-diagnostics/USB-SHA256SUMS"}:
            old = mountpoint / name
            if old.is_file():
                saved = backup / name; saved.parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(old, saved)
        atomic_write(backup / "installed.json", data=json.dumps(previous, indent=2).encode())
    # Payload first; loader-facing files last. No console boot occurs during staging.
    ordered = sorted((n for n in files if n.startswith("psx-diagnostics/"))) + ["bzImage", "initramfs.cpio.gz", "vram.txt"]
    installed = {}
    for name in ordered:
        target = mountpoint / name
        if not target.exists() or digest(target) != files[name]:
            atomic_write(target, source=source / name)
        if digest(target) != files[name]:
            raise ValueError(f"USB readback differs: {name}")
        installed[name] = files[name]
    atomic_write(mountpoint / "bootargs.txt", data=bootargs)
    installed["bootargs.txt"] = hashlib.sha256(bootargs).hexdigest()
    marker = dict(plan, owner="psx-diagnostics-usb-v1", files=installed,
                  staged_unix=time.time(), verified_readback=True,
                  uart="not used for host-only regular-file preparation; required before console boot")
    atomic_write(mountpoint / "psx-diagnostics/installed.json", data=(json.dumps(marker, indent=2) + "\n").encode())
    atomic_write(mountpoint / "psx-diagnostics/USB-SHA256SUMS", data=installed_sums(installed).encode())
    return marker


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path, required=True)
    parser.add_argument("--device", type=Path, required=True)
    parser.add_argument("--expect-serial", required=True)
    parser.add_argument("--expect-bytes", type=int, required=True)
    parser.add_argument("--mountpoint", type=Path, required=True)
    parser.add_argument("--receipt", type=Path)
    parser.add_argument("--apply", action="store_true")
    args = parser.parse_args()
    if args.receipt:
        args.receipt = args.receipt.resolve()
    source = args.source.resolve(strict=True)
    files, metadata = source_files(source)
    mountpoint, device = inspect(args)
    template = (source / "bootargs.template.txt").read_text()
    if template.count("@USB_UUID@") != 1:
        raise ValueError("bootargs must bind exactly one selected USB UUID")
    bootargs = render_bootargs(template, device["uuid"], metadata)
    previous = previous_install(mountpoint, device)
    expected_names = {name for name in files if name != "bootargs.template.txt"} | {"bootargs.txt"}
    owned = previous.get("files", {}) if previous else {}
    for name in expected_names:
        target = mountpoint / name
        if target.exists() and name not in owned:
            raise ValueError(f"refusing to replace an unowned existing file: {name}")
        if target.is_symlink() or not target.resolve().is_relative_to(mountpoint):
            raise ValueError("destination escapes the selected USB")
        if target.exists() and digest(target) != owned[name]:
            raise ValueError(f"existing diagnostic file changed outside the staged receipt: {name}")
    size = sum((source / name).stat().st_size for name in files) + len(bootargs)
    if shutil.disk_usage(mountpoint).free < 2 * size + 16 * 1024 * 1024:
        raise ValueError("insufficient space for the staged set and rollback")
    plan = {"action": "copy regular files; no format or repartition", "target": device,
            "profile": metadata["profile"], "kernel_release": metadata["kernel_release"],
            "source_files": len(files), "bytes": size, "apply": args.apply,
            "console_operation": False, "hardware_acceptance": False}
    print(json.dumps(plan, indent=2), flush=True)
    if not args.apply:
        return
    # Re-check the by-id target immediately before the first consequential write.
    _, checked = inspect(args)
    if checked != device:
        raise ValueError("USB identity changed before copying")
    with pinned_mount(mountpoint, Path(device["partition"]).stat().st_rdev):
        marker = copy_boot_set(source, files, bootargs, previous, plan, expected_names)
        os.sync()
    _, final = inspect(args)
    if final != device:
        raise ValueError("USB identity changed while copying")
    if args.receipt:
        args.receipt.parent.mkdir(parents=True, exist_ok=True)
        args.receipt.write_text(json.dumps(marker, indent=2) + "\n")
    print("PASS: diagnostic USB files copied and read back; no partition or filesystem changed")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        raise SystemExit(f"error: {error}")
