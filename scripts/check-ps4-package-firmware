#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Fail if a DiagnostiX initramfs holds firmware that each console's loader must supply.

Checks every early-boot file, every file in a tar member, and each embedded ext4
image block by block, so a copy under another name or left in freed space is found
too. The manifest holds names and hashes, never firmware bytes. Host only.
"""
from __future__ import annotations

import argparse
import gzip
import hashlib
import importlib.machinery
import importlib.util
import io
import json
from pathlib import Path
import subprocess
import sys
import tarfile
import tempfile

REPO = Path(__file__).resolve().parents[1]
MANIFEST = REPO / 'manifests/ps4-package-forbidden-firmware.json'
# The smallest ext4 block: any file's content sits on a multiple of this in its image.
BLOCK = 1024
DECOMPRESSORS = {b'\x28\xb5\x2f\xfd': 'zstd', b'\xfd7zXZ\x00': 'xz', b'\x1f\x8b': 'gzip'}


def load_rules(path=MANIFEST):
    data = json.loads(Path(path).read_text())
    return {'fragments': tuple(data['forbidden_path_fragments']),
            'files': {item['sha256']: item['name'] for item in data['forbidden_files']},
            'blocks': {digest: item['name'] for item in data['forbidden_files'] for digest in item['block_sha256']}}


def load_members():
    path = REPO / 'scripts/repack-ps4-diagnostix'
    loader = importlib.machinery.SourceFileLoader('repack_ps4_diagnostix', str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module.members


def sha(data):
    return hashlib.sha256(data).hexdigest()


def check_file(label, name, data, rules):
    problems = []
    if any(fragment in name for fragment in rules['fragments']):
        problems.append(f'{label}: forbidden path {name}')
    if sha(data) in rules['files']:
        problems.append(f'{label}: {name} has the bytes of {rules["files"][sha(data)]}')
    return problems


def check_tar(label, data, rules):
    problems = []
    with tarfile.open(fileobj=io.BytesIO(data)) as archive:
        for item in archive:
            content = archive.extractfile(item).read() if item.isreg() else b''
            problems += check_file(label, item.name, content, rules)
    return problems


def firmware_paths(image, directory='/usr/lib/firmware'):
    """Every path under the firmware directory; `ls -p` prints /inode/mode/uid/gid/name/size/."""
    listing = subprocess.run(['debugfs', '-R', f'ls -p "{directory}"', str(image)],
                             capture_output=True, text=True, check=True).stdout
    for line in listing.splitlines():
        fields = line.split('/')
        if len(fields) == 8 and fields[5] not in ('.', '..'):
            path = f'{directory}/{fields[5]}'
            yield path
            if int(fields[2], 8) & 0o170000 == 0o040000:
                yield from firmware_paths(image, path)


def check_image(label, image, rules):
    problems = set()
    with open(image, 'rb') as stream:
        stream.seek(1024 + 56)
        if stream.read(2) != b'\x53\xef':
            raise ValueError(label + ': expected an ext4 image')
        stream.seek(0)
        while block := stream.read(BLOCK):
            if len(block) == BLOCK and sha(block) in rules['blocks']:
                problems.add(f'{label}: holds a block of {rules["blocks"][sha(block)]}')
    for path in firmware_paths(image):
        if any(fragment in path for fragment in rules['fragments']):
            problems.add(f'{label}: forbidden path {path}')
    return sorted(problems)


def check(initramfs, rules):
    """(problems, member count, names of the images scanned)."""
    raw = gzip.decompress(Path(initramfs).read_bytes())
    found, _ = load_members()(raw)
    problems, images = [], []
    with tempfile.TemporaryDirectory(dir='/var/tmp') as temporary:
        packed, image = Path(temporary) / 'packed', Path(temporary) / 'image'
        for member in found:
            name, data = member['name'], raw[member['start']:member['start'] + member['size']]
            problems += check_file('early boot', name, data, rules) if data else []
            if name.endswith('.tar'):
                problems += check_tar(name, data, rules)
            tool = next((value for magic, value in DECOMPRESSORS.items() if data.startswith(magic)), None)
            if tool and '.ext4' in name:
                packed.write_bytes(data)
                with image.open('wb') as stream:
                    subprocess.run([tool, '-dc', str(packed)], stdout=stream, check=True)
                problems += check_image(name, image, rules)
                images.append(name)
    return problems, len(found), images


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('initramfs', type=Path, help='initramfs.cpio.gz to check')
    parser.add_argument('--manifest', type=Path, default=MANIFEST)
    args = parser.parse_args()
    problems, count, images = check(args.initramfs, load_rules(args.manifest))
    print(json.dumps({'status': 'FAIL' if problems else 'PASS', 'members': count,
                      'images_scanned': images, 'problems': problems}, indent=1))
    return 1 if problems else 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, ValueError, KeyError, tarfile.TarError, subprocess.SubprocessError) as error:
        print(error, file=sys.stderr)
        raise SystemExit(2)
