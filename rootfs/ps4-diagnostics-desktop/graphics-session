#!/bin/bash
# SPDX-License-Identifier: MIT
set -uo pipefail
case "${PSX_GRAPHICS_MODE:-}" in browser|chromium|protondb|opengl|vulkan|diagnostics|benchmark|benchmark-vulkan) ;; *) exit 2 ;; esac
# This account cannot write the kernel log. The controller copies this file there as it grows.
trace() {
    case "$PSX_GRAPHICS_MODE" in benchmark|benchmark-vulkan) ;; *) return 0 ;; esac
    [[ -w /run/psx-benchmark ]] && printf '%s\n' "$*" >> /run/psx-benchmark/trace.log
    return 0
}
trace "graphics-session running as $(id -un)"
export DISPLAY=:0
if [[ "${PSX_GRAPHICS_WINDOWED:-0}" == 1 ]]; then
    [[ "$PSX_GRAPHICS_MODE" != diagnostics ]] || exit 2
    export XAUTHORITY=/run/psx-graphics-user/Xauthority
else
    export XAUTHORITY=/run/psx-desktop/Xauthority
fi
if [[ "$PSX_GRAPHICS_MODE" == diagnostics ]]; then
    export XDG_RUNTIME_DIR=/run/user/0
else
    export XDG_RUNTIME_DIR=/run/user/1000
fi
unset WAYLAND_DISPLAY
. /etc/psx-diagnostics/mesa.env
if [[ "${PSX_GRAPHICS_WINDOWED:-0}" != 1 ]]; then
    trace "starting xfwm4"
    /usr/bin/xfwm4 --compositor=off --replace &
    wm_pid=$!
    trap 'kill "$wm_pid" 2>/dev/null || true' EXIT
    wait_wm=/run/psx-frontend/wait-graphics-wm
    [[ -x "$wait_wm" ]] || wait_wm=/usr/lib/psx-diagnostics/wait-graphics-wm
    if [[ ! -x "$wait_wm" ]] || ! /usr/bin/python3 "$wait_wm"; then
        trace "window manager did not start"
        printf '%s\n' 'Diagnostic window manager did not start; returning to the console.' >&2
        exit 1
    fi
    trace "window manager ready"
fi
case "$PSX_GRAPHICS_MODE" in
    diagnostics)
        terminal=/run/psx-frontend/xfce4-terminal
        font=/run/psx-frontend/JetBrainsMonoNerdFont-Regular.ttf
        [[ -x "$terminal" && -r "$font" ]] || exit 1
        export XDG_CONFIG_HOME="$HOME/.config" XDG_DATA_HOME="$HOME/.local/share"
        export XDG_CACHE_HOME="$HOME/.cache" COLORTERM=truecolor TERM=xterm-256color
        font_dir="$XDG_DATA_HOME/fonts"
        mkdir -p "$font_dir" || exit 1
        ln -sfn "$font" "$font_dir/JetBrainsMonoNerdFont-Regular.ttf" || exit 1
        /usr/bin/fc-cache "$font_dir" || exit 1
        preferences=/run/psx-frontend/preferences.py
        [[ -r "$preferences" ]] || preferences=/opt/psx-diagnostics/preferences.py
        if ! /usr/bin/python3 "$preferences" session-start --session-pid "$$"; then
            printf '%s\n' 'Cannot apply graphical terminal preferences; returning to the console.' >&2
            exit 1
        fi
        LD_LIBRARY_PATH="/run/psx-frontend${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
            "$terminal" --disable-server --fullscreen --hide-menubar --hide-toolbar \
            --hide-scrollbar --hide-borders --title='Diagnostix' \
            --execute /usr/bin/psx-diagnostics-tui --socket /run/psx-diagnostics/control.sock
        exit $? ;;
    chromium)
        chromium=/run/psx-frontend/launch-chromium-provider
        [[ -x "$chromium" ]] || chromium=/usr/lib/psx-diagnostics/launch-chromium-provider
        if [[ ! -x "$chromium" ]]; then
            printf '%s\n' 'Chromium requires the optional verified 384 MiB USB provider.' >&2
            exit 1
        fi
        "$chromium"
        exit $? ;;
    browser|protondb)
        browser_target=http://127.0.0.1:8080/lab
        if [[ "$PSX_GRAPHICS_MODE" == protondb ]]; then
            browser_target=https://www.protondb.com/
        fi
        profile_parent="$HOME/.local/share/psx-diagnostics/firefox"
        mkdir -p "$profile_parent" || exit 1
        chmod 0700 "$profile_parent" || exit 1
        profile=$(mktemp -d "$profile_parent/session-XXXXXXXX") || exit 1
        cp /etc/psx-diagnostics/firefox-user.js "$profile/user.js" || exit 1
        cat >> "$profile/user.js" <<'EOF'
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("browser.sessionstore.max_resumed_crashes", 0);
user_pref("browser.startup.page", 0);
user_pref("browser.cache.disk.enable", false);
user_pref("browser.aboutwelcome.enabled", false);
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("startup.homepage_welcome_url", "");
user_pref("startup.homepage_welcome_url.additional", "");
user_pref("datareporting.policy.firstRunURL", "");
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.preonboarding.splashShown", true);
user_pref("browser.aboutwelcome.experimentsGate.enabled", false);
user_pref("termsofuse.bypassNotification", true);
user_pref("datareporting.policy.dataSubmissionPolicyBypassNotification", true);
EOF
        /usr/bin/python3 /opt/psx-mesa-tools/with-mesa.py --root /opt/psx-mesa \
            --runtime-dir "/run/psx-mesa/$(id -u)" \
            --expected-manifest-sha256 "$PSX_MESA_MANIFEST_SHA256" \
            -- /usr/bin/firefox --no-remote --profile "$profile" --kiosk "$browser_target"
        exit $? ;;
    benchmark|benchmark-vulkan)
        tools=/run/psx-bench
        results=/run/psx-benchmark
        scene_seconds=5
        if [[ "$PSX_GRAPHICS_MODE" == benchmark ]]; then tool=glmark2; else tool=vkmark; fi
        [[ -x "$tools/bin/$tool" && -w "$results" ]] || { trace "no usable $tool"; exit 1; }
        export LD_LIBRARY_PATH="$tools/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        # dd with one-byte blocks because the file has to grow as the tool writes:
        # after a hang, its last line is the scene that was running.
        measure() {
            local name=$1 limit=$2 status
            shift 2
            trace "$name starting, limit ${limit}s"
            /usr/bin/timeout --signal=TERM --kill-after=3 "$limit" "$@" 2>&1 |
                /usr/bin/dd bs=1 count=1048576 status=none of="$results/$name.log"
            status=${PIPESTATUS[0]}
            printf '%s\n' "$status" > "$results/$name.status"
            trace "$name exited with status $status"
        }
        if [[ "$tool" == glmark2 ]]; then
            measure glmark2 360 "$tools/bin/glmark2" --data-path "$tools/share/glmark2" \
                --fullscreen -b ":duration=$scene_seconds"
        else
            measure vkmark 180 "$tools/bin/vkmark" --winsys xcb --winsys-dir "$tools/lib/vkmark" \
                --data-dir "$tools/share/vkmark" --fullscreen -b ":duration=$scene_seconds"
        fi
        exit 0 ;;
    opengl) program=/usr/bin/glxgears; args=(-info) ;;
    vulkan) program=/usr/bin/vkcube; args=() ;;
esac
/usr/bin/timeout --signal=TERM --kill-after=3 60 \
    /usr/bin/python3 /opt/psx-mesa-tools/with-mesa.py --root /opt/psx-mesa \
    --runtime-dir "/run/psx-mesa/$(id -u)" \
    --expected-manifest-sha256 "$PSX_MESA_MANIFEST_SHA256" \
    -- "$program" "${args[@]}"
status=$?
case "$status" in 0|124) exit 0 ;; *) exit "$status" ;; esac
