 	device_wakeup_enable(&pdev->dev);
 
@@ -466,6 +475,9 @@
 	if(dev->device != PCI_DEVICE_ID_SONY_AEOLIA_XHCI) {
 		retval = ahci_init_one(dev);
 		dev_dbg(&dev->dev, "ahci_init_one returned %d", retval);
+		/* Only pre-host errors are safe for this outer probe to unwind. */
+		if (retval && xhci_aeolia_is_baikal(&dev->dev) && !axhci->host)
+			goto free_irqs;
 		if (!bus_master) {
 			pci_set_master(dev);
 			bus_master = true;
@@ -502,6 +514,7 @@
 remove_hcds:
 	while (idx--)
 		xhci_aeolia_remove_one(dev, idx);
+free_irqs:
 	apcie_free_irqs(dev->irq, axhci->nr_irqs);
 free_axhci:
 	devm_kfree(&dev->dev, axhci);
