+	/* Shared-HDD Baikal path: rmuxnet 858d97a4519d, adapted for this probe. */
+	if (pdev->device == PCI_DEVICE_ID_SONY_BAIKAL_XHCI) {
+		ps4_sata_diag(&pdev->dev, "embedded_ahci.baikal_phy.begin\n");
+		rc = bpcie_baikal_sata_phy_init(pdev, hpriv->mmio);
+		ps4_sata_diag(&pdev->dev, "embedded_ahci.baikal_phy.end rc=%d\n", rc);
+		if (rc)
+			goto unmap_registers;
+	} else {
+		r_mem = kzalloc(sizeof(*r_mem), GFP_KERNEL);
+		if (r_mem) {
+			r_mem->r_bustag = 1;//mem
