+	va_list args;
+	int line;
+
+	if (!ps4_sata_diag_enabled)
+		return;
+	line = atomic_inc_return(&ps4_sata_diag_fault_lines);
+	if (line > 32) {
+		if (line == 33)
+			pr_info("PS4_SATA_DIAG fault limit=32 reached; use native ATA logs\n");
+		return;
+	}
+	va_start(args, fmt);
+	vaf.fmt = fmt;
+	vaf.va = &args;
+	pr_info("PS4_SATA_DIAG fault_seq=%d %pV", line, &vaf);
+	va_end(args);
+}
+EXPORT_SYMBOL_GPL(ps4_sata_diag_fault_emit);
