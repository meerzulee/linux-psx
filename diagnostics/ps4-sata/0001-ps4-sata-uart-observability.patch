+	va_start(args, fmt);
+	vaf.fmt = fmt;
+	vaf.va = &args;
+	pr_info("PS4_SATA_DIAG seq=%d %pV", line, &vaf);
+	va_end(args);
+}
+EXPORT_SYMBOL_GPL(ps4_sata_diag_emit);
