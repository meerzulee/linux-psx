@@ -6113,13 +6195,22 @@
 	if (!(ap->host->flags & ATA_HOST_PARALLEL_SCAN) && ap->port_no != 0)
 		async_synchronize_cookie(cookie);
 
+	ps4_sata_diag_ap(ap, "async_probe.eh_submit\n");
