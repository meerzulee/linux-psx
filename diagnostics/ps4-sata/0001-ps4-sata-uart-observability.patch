diff --git a/include/linux/ps4-sata-diag.h b/include/linux/ps4-sata-diag.h
new file mode 100644
--- /dev/null
+++ b/include/linux/ps4-sata-diag.h
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Opt-in, bounded observations for the Baikal shared xHCI/HDD function. */
+#ifndef _LINUX_PS4_SATA_DIAG_H
+#define _LINUX_PS4_SATA_DIAG_H
+
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/jiffies.h>
+#include <linux/pci.h>
+#include <linux/printk.h>
+
+extern bool ps4_sata_diag_enabled;
+void ps4_sata_diag_emit(const char *fmt, ...) __printf(1, 2);
+void ps4_sata_diag_fault_emit(const char *fmt, ...) __printf(1, 2);
+
+struct ata_queued_cmd;
+void ps4_sata_diag_qc_dma(struct ata_queued_cmd *qc, bool failure);
+
+static inline bool ps4_sata_diag_match(struct device *dev)
+{
+	struct pci_dev *pdev;
+
+	if (!ps4_sata_diag_enabled || !dev || !dev_is_pci(dev))
+		return false;
+	pdev = to_pci_dev(dev);
+	return pdev->vendor == 0x104d && pdev->device == 0x90de &&
+		pci_domain_nr(pdev->bus) == 0 && pdev->bus->number == 0 &&
+		pdev->devfn == PCI_DEVFN(0x14, 7);
+}
+
+#define __ps4_sata_diag(emit, dev, fmt, ...) do { \
+	struct device *__diag_dev = (dev); \
+	if (ps4_sata_diag_match(__diag_dev)) \
+		emit("%s " fmt, dev_name(__diag_dev), ##__VA_ARGS__); \
+} while (0)
+
+#define ps4_sata_diag(dev, fmt, ...) \
