+/* No payload access; inspect only the already mapped SG descriptors. */
+void ps4_sata_diag_qc_dma(struct ata_queued_cmd *qc, bool failure)
+{
+	static atomic_t mapped_lines = ATOMIC_INIT(0);
+	static atomic_t failed_lines = ATOMIC_INIT(0);
+	struct ata_port *ap = qc->ap;
+	struct scatterlist *sg;
+	u64 low = U64_MAX, high = 0;
+	bool cross_2g = false;
+	unsigned int i, nonzero = 0;
+
+	if (ap->port_no != 0 || !ps4_sata_diag_match(ap->host->dev))
+		return;
+	if (!(qc->flags & ATA_QCFLAG_DMAMAP) || !qc->sg || !qc->n_elem)
+		return;
+	if (atomic_inc_return(failure ? &failed_lines : &mapped_lines) >
+	    (failure ? 16 : 32))
+		return;
+	for_each_sg(qc->sg, sg, qc->n_elem, i) {
+		u64 begin = sg_dma_address(sg);
+		u32 len = sg_dma_len(sg);
+		u64 end;
+
+		if (!len)
+			continue;
+		end = begin + len - 1;
+		nonzero++;
+
+		low = min(low, begin);
+		high = max(high, end);
+		cross_2g |= (begin >> 31) != (end >> 31);
+	}
+	if (!nonzero)
+		low = 0;
+	__ps4_sata_diag_ap((failure ? ps4_sata_diag_fault_emit : ps4_sata_diag_emit), ap,
+		"dma.%s cmd=%#x protocol=%u tag=%u hw_tag=%u n_elem=%u "
+		"nz_elem=%u min=%#llx max=%#llx above31=%u cross2g=%u err=%#x\n",
+		failure ? "error" : "mapped", qc->tf.command, qc->tf.protocol,
+		qc->tag, qc->hw_tag, qc->n_elem, nonzero, (unsigned long long)low,
+		(unsigned long long)high, high > DMA_BIT_MASK(31), cross_2g,
+		qc->err_mask);
+}
+
 #ifdef CONFIG_HAS_DMA
 
 /**
@@ -4920,6 +4994,7 @@
 	qc->orig_n_elem = qc->n_elem;
 	qc->n_elem = n_elem;
 	qc->flags |= ATA_QCFLAG_DMAMAP;
+	ps4_sata_diag_qc_dma(qc, false);
 
 	return 0;
 }
