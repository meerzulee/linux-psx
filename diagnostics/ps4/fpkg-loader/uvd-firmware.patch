+/*
+ * FW12.00/12.02: the UVD image sits in the kernel's read-only segment. Only an
+ * exact match is wrapped and added, using the standard amdgpu common header, so
+ * the result is byte for byte the 314168-byte file the driver was tested with.
+ * Any other kernel adds nothing and the rest of the archive is unaffected.
+ */
+#define UVD_KERNEL_OFFSET 0x8cbff0ULL
+#define UVD_RAW_SIZE FW_UVD_RAW_SIZE
+#define UVD_RAW_CRC32 0xa465ba07U
+#define UVD_UCODE_VERSION 0x012a6509U
+
+static int add_uvd_firmware(u8 **p, const char *path)
+{
+    const u8 *raw = (const u8 *)(kern.kern_base + UVD_KERNEL_OFFSET);
+    u32 crc = crc32(0, raw, UVD_RAW_SIZE);
+
+    kern.printf("firmware_extract: UVD kernel range crc32=%x expected=%x\n",
+                crc, UVD_RAW_CRC32);
+    if (crc != UVD_RAW_CRC32) {
+        kern.printf("firmware_extract: UVD left out, kernel range differs\n");
+        return 0;
+    }
+
+    cpio_hdr(p, path, FILE, FW_HEADER_SIZE + UVD_RAW_SIZE);
+    struct firmware_header *fhdr = (struct firmware_header*)*p;
+    memset(fhdr, 0, sizeof(*fhdr));
+    fhdr->size_bytes = sizeof(*fhdr) + UVD_RAW_SIZE;
+    fhdr->header_size_bytes = offsetof(struct firmware_header, raw);
+    fhdr->header_version_major = 1;
+    fhdr->header_version_minor = 0;
+    fhdr->ip_version_major = 4;
+    fhdr->ip_version_minor = 2;
+    fhdr->ucode_version = UVD_UCODE_VERSION;
+    fhdr->ucode_size_bytes = UVD_RAW_SIZE;
+    fhdr->ucode_array_offset_bytes = sizeof(*fhdr);
+    fhdr->crc32 = crc;
+    *p += sizeof(*fhdr);
+    memcpy(*p, raw, UVD_RAW_SIZE);
+    *p += UVD_RAW_SIZE;
+    return 1;
+}
