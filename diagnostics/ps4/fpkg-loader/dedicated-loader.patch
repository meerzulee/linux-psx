+        {0x80000ULL, 0x9a000ULL}, {0x100000ULL, 0x400000ULL},
+        {0x480000ULL, 0x680000ULL}, {0x700000ULL, 0x7efe8000ULL},
+        {0x7f000000ULL, 0x80000000ULL}, {0x140000000ULL, DIAG_RAM_END}
+    };
