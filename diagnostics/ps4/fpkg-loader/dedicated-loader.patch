-#define	VM_MEMATTR_DEFAULT		0x06
+/* kmem_free needs the original kernel-map VA, never the direct-map alias. */
+struct contig_record { void *direct; vm_offset_t mapped; size_t bytes, requested; };
+static struct contig_record contig_records[4];
+
+_Static_assert(sizeof(vm_offset_t) == 8 && sizeof(vm_paddr_t) == 8 &&
+               sizeof(size_t) == 8 && sizeof(void *) == 8,
+               "Diagnostix requires the reviewed 64-bit allocator ABI");
+
+/* One failure record, including post-allocation rejection before cleanup.
+ * Addresses are private UART evidence, never a new read or an alternate path.
+ */
+static void contig_report(const char *reason, unsigned int attempts,
+                          size_t requested, size_t rounded, vm_paddr_t high,
+                          vm_offset_t mapped, vm_paddr_t physical,
+                          size_t offset, vm_paddr_t observed)
+{
+    kern.printf("DIAGNOSTIX_ALLOC_V1 reason=%s attempts=%u requested=%llu rounded=%llu "
+                "flags=0x%x low=0 high=0x%llx alignment=0x%x guard_high=0x%llx vm=0x%llx "
+                "physical=0x%llx page_offset=0x%llx observed=0x%llx dmap=0x%llx\n",
+                reason, attempts, (unsigned long long)requested,
+                (unsigned long long)rounded, M_ZERO | M_WAITOK,
+                (unsigned long long)~(vm_paddr_t)0, 1, (unsigned long long)high,
+                (unsigned long long)mapped, (unsigned long long)physical,
+                (unsigned long long)offset, (unsigned long long)observed,
+                (unsigned long long)kern.dmap_base);
+}
+
+void *kernel_alloc_contig_limit(size_t size, vm_paddr_t high)
+{
+    unsigned int slot;
+    size_t bytes, offset = 0;
+    vm_offset_t mapped;
+    vm_paddr_t physical, observed = 0;
+    u64 direct = 0;
+    const char *reason;
+    if (!size || size > 1024ULL * 1024 * 1024 || size > ~(size_t)0 - PAGE_MASK) {
+        contig_report("request-size", 0, size, 0, high, 0, 0, 0, 0);
+        return NULL;
+    }
+    if (!high || high > DIAG_RAM_END) {
+        contig_report("request-high", 0, size, 0, high, 0, 0, 0, 0);
+        return NULL;
+    }
+    if (!diag_dmap_base_valid(kern.dmap_base)) {
+        contig_report("dmap-base", 0, size, 0, high, 0, 0, 0, 0);
+        return NULL;
+    }
+    bytes = (size + PAGE_MASK) & ~(size_t)PAGE_MASK;
+    for (slot = 0; slot < 4 && contig_records[slot].direct; ++slot);
+    if (slot == 4) {
+        contig_report("ledger-full", 0, size, bytes, high, 0, 0, 0, 0);
+        return NULL;
+    }
+    /* Match each upstream call exactly, but bound its outer zero-return retry
+     * at three attempts. Post-allocation validation failures never retry.
+     */
+    unsigned int attempt;
+    for (attempt = 1; attempt <= 3; ++attempt) {
+        kern.printf("DIAGNOSTIX_ALLOC_V2 event=begin policy=UPSTREAM_BOUNDED3 attempt=%u of=3 requested=%llu "
+                    "rounded=%llu flags=0x%x low=0 high=0x%llx alignment=0x%x guard_high=0x%llx\n",
+                    attempt, (unsigned long long)size, (unsigned long long)bytes,
+                    M_ZERO | M_WAITOK, (unsigned long long)~(vm_paddr_t)0, 1,
+                    (unsigned long long)high);
+        mapped = kern.kmem_alloc_contig(*kern.kernel_map, size, M_ZERO | M_WAITOK,
+                                      0, ~(vm_paddr_t)0, 1, 0, VM_MEMATTR_DEFAULT);
+        kern.printf("DIAGNOSTIX_ALLOC_V2 event=end policy=UPSTREAM_BOUNDED3 attempt=%u of=3 requested=%llu "
+                    "rounded=%llu flags=0x%x high=0x%llx alignment=0x%x guard_high=0x%llx vm=0x%llx\n",
+                    attempt, (unsigned long long)size, (unsigned long long)bytes,
+                    M_ZERO | M_WAITOK, (unsigned long long)~(vm_paddr_t)0, 1,
+                    (unsigned long long)high, (unsigned long long)mapped);
+        if (mapped) break;
+    }
+    if (!mapped) {
+        contig_report("kmem-returned-zero", 3, size, bytes, high, 0, 0, 0, 0);
+        return NULL;
+    }
+    physical = kern.pmap_extract(kern.kernel_pmap_store, mapped);
+    if (mapped & PAGE_MASK) { reason = "vm-unaligned"; goto fail; }
+    if (!physical) { reason = "physical-zero"; goto fail; }
+    if (physical & PAGE_MASK) { reason = "physical-unaligned"; goto fail; }
+    if (physical > ~(vm_paddr_t)0 - (bytes - 1)) {
+        reason = "physical-overflow"; goto fail;
+    }
+    if (physical >= high || bytes > high - physical) { reason = "physical-above-high"; goto fail; }
+    if (mapped > ~(vm_offset_t)0 - (bytes - 1)) { reason = "vm-overflow"; goto fail; }
