--- a/linux/Makefile
+++ b/linux/Makefile
@@ -53,6 +53,9 @@
 # ── kexec blob lists ──────────────────────────────────────────────────────────
 
 KEXEC_BINS = $(foreach fw,$(FIRMWARES),$(KEXEC_BUILD_DIR)/$(fw)/kexec.bin)
+KEXEC_LAYOUT_1200 = $(KEXEC_BUILD_DIR)/1200/kexec-layout.h
+KEXEC_SLIM_1200 = $(KEXEC_BUILD_DIR)/1200/kexec.slim
+KEXEC_FOOTER_1200 = $(KEXEC_BUILD_DIR)/1200/kexec.footer
 # ── AIO target list ───────────────────────────────────────────────────────────
 
 AIO_TARGETS = $(foreach sz,$(SIZES_MB), payloads/linux-$(sz)mb.bin)
@@ -80,6 +83,35 @@
 	    FW_DEFINE=$(call fw_define,$*) \
 	    BUILD_DIR=$(abspath $(dir $@))
 
+# The runtime .bss is zeroed after the slim image is copied into the kernel
+# allocation. Do not embed the zero-filled BSS in the outer payload.
+$(KEXEC_LAYOUT_1200): $(KEXEC_BUILD_DIR)/1200/kexec.bin
+	@{ echo '#pragma once'; \
+	   readelf -SW $(KEXEC_BUILD_DIR)/1200/kexec.elf | \
+	   awk '$$2==".bss" {bss_a=$$4; bss_s=$$6} $$2==".footer" {foot_a=$$4; foot_s=$$6} END {printf "#define KEXEC_IMAGE_BYTES 0x%sULL\n#define KEXEC_BSS_OFFSET 0x%sULL\n#define KEXEC_BSS_BYTES 0x%sULL\n#define KEXEC_FOOTER_OFFSET 0x%sULL\n#define KEXEC_FOOTER_BYTES 0x%sULL\n", bss_a, bss_a, bss_s, foot_a, foot_s}'; \
+	} > $@
+	test -s $@
+
+$(KEXEC_SLIM_1200): $(KEXEC_BUILD_DIR)/1200/kexec.bin $(KEXEC_LAYOUT_1200)
+	objcopy -O binary \
+	    --only-section .init \
+	    --only-section .text \
+	    --only-section .data \
+	    --only-section .dynamic \
+	    --only-section .rodata \
+	    --only-section .note.gnu.property \
+	    --only-section .dynsym \
+	    --only-section .dynstr \
+	    --only-section .gnu.hash \
+	    $(KEXEC_BUILD_DIR)/1200/kexec.elf $@
+	@{ off=$$(awk '/KEXEC_BSS_OFFSET/ {gsub(/ULL/,"",$$3); print $$3}' $(KEXEC_LAYOUT_1200)); \
+	   truncate -s $$(printf '%d' "$$off") $@; }
+
+$(KEXEC_FOOTER_1200): $(KEXEC_BUILD_DIR)/1200/kexec.bin $(KEXEC_LAYOUT_1200)
+	@{ off=$$(awk '/KEXEC_FOOTER_OFFSET/ {gsub(/ULL/,"",$$3); print $$3}' $(KEXEC_LAYOUT_1200)); \
+	   bytes=$$(awk '/KEXEC_FOOTER_BYTES/ {gsub(/ULL/,"",$$3); print $$3}' $(KEXEC_LAYOUT_1200)); \
+	   dd if=$(KEXEC_BUILD_DIR)/1200/kexec.bin of=$@ bs=1 skip=$$(printf '%d' "$$off") count=$$(printf '%d' "$$bytes") status=none; }
+
 # ── ELF → BIN conversion ─────────────────────────────────────────────────────
 
 %.bin: %.elf
