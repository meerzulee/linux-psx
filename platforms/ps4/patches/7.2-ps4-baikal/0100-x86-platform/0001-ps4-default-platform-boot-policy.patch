--- a/arch/x86/pci/acpi.c
+++ b/arch/x86/pci/acpi.c
@@ -1,63 +1,64 @@
 // SPDX-License-Identifier: GPL-2.0
 
 #define pr_fmt(fmt) "PCI: " fmt
 
 #include <linux/pci.h>
 #include <linux/acpi.h>
