From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Meerzulee <17146298+meerzulee@users.noreply.github.com>
Date: Sat, 17 Oct 2026 00:00:00 +0000
Subject: [PATCH] ps4: bpcie: replace pci_msi_create_irq_domain() removed in
 Linux 7.2

Linux 7.2 removed pci_msi_create_irq_domain(). The Baikal MSI parent
domain was tested on hardware with Linux 6.18, where that helper set the
PCI/MSI flags, made the chip oneshot-safe and used DOMAIN_BUS_PCI_MSI
before calling msi_create_irq_domain(). Do the same in the driver.

The helper's default domain and chip ops are not needed here, because
bpcie_msi_domain_ops and bpcie_msi_controller already provide set_desc,
irq_write_msi_msg, irq_mask and irq_unmask. Warn if that ever changes.
---
 drivers/ps4/ps4-bpcie.c | 33 ++++++++++++++++++++++++++++++++-
 1 file changed, 32 insertions(+), 1 deletion(-)

diff --git a/drivers/ps4/ps4-bpcie.c b/drivers/ps4/ps4-bpcie.c
index fe3b78da8670e087e51630b5257013709e5be304..d4e9e14a2969338ebe074de65a30708fbdab2568 100644
--- a/drivers/ps4/ps4-bpcie.c
+++ b/drivers/ps4/ps4-bpcie.c
@@ -543,6 +543,37 @@ static const struct msi_parent_ops bpcie_msi_parent_ops = {
 	.prefix			= "bpcie-",
 };
 
+/*
+ * Linux 7.2 removed pci_msi_create_irq_domain(). This does what it did in
+ * Linux 6.18, where this domain setup was tested on Baikal. Its default
+ * domain and chip ops are not needed: bpcie_msi_domain_ops and
+ * bpcie_msi_controller already provide them.
+ */
+static struct irq_domain *bpcie_pci_msi_create_irq_domain(struct fwnode_handle *fwnode,
+							  struct msi_domain_info *info,
+							  struct irq_domain *parent)
+{
+	WARN_ON(!info->ops->set_desc || !info->chip->irq_write_msi_msg ||
+		!info->chip->irq_mask || !info->chip->irq_unmask);
+
+	if (WARN_ON(info->flags & MSI_FLAG_LEVEL_CAPABLE))
+		info->flags &= ~MSI_FLAG_LEVEL_CAPABLE;
+
+	/* Let the core code free MSI descriptors when freeing interrupts */
+	info->flags |= MSI_FLAG_FREE_MSI_DESCS;
+
+	info->flags |= MSI_FLAG_ACTIVATE_EARLY | MSI_FLAG_DEV_SYSFS;
+	if (IS_ENABLED(CONFIG_GENERIC_IRQ_RESERVATION_MODE))
+		info->flags |= MSI_FLAG_MUST_REACTIVATE;
+
+	/* PCI-MSI is oneshot-safe */
+	info->chip->flags |= IRQCHIP_ONESHOT_SAFE;
+	/* Let the core update the bus token */
+	info->bus_token = DOMAIN_BUS_PCI_MSI;
+
+	return msi_create_irq_domain(fwnode, info, parent);
+}
+
 struct irq_domain *bpcie_create_irq_domain(struct bpcie_dev *sc, struct pci_dev *pdev)//similar to hpet_create_irq_domain
 {
 	struct irq_domain *domain, *parent;
@@ -589,7 +620,7 @@ struct irq_domain *bpcie_create_irq_domain(struct bpcie_dev *sc, struct pci_dev
 	 * chip_ops to set proper PCI MSI defaults.  Sets bus_token to
 	 * DOMAIN_BUS_PCI_MSI (we override below to AMDVI for x86 vector
 	 * gate compat — see irq_domain_update_bus_token call). */
-	domain = pci_msi_create_irq_domain(fn, &bpcie_msi_domain_info, parent);
+	domain = bpcie_pci_msi_create_irq_domain(fn, &bpcie_msi_domain_info, parent);
 	if (!domain) {
 		irq_domain_free_fwnode(fn);
 		pr_warn("Failed to initialize Baikal-MSI irqdomain.\n");
