 drivers/pci/msi/irqdomain.c      |  3 ++-
 drivers/pci/probe.c              | 19 +++++++++++++++++++
 include/linux/msi.h              |  3 +++
 include/linux/pci_ids.h          | 26 ++++++++++++++++++++++++++
 kernel/irq/msi.c                 |  2 +-
 9 files changed, 75 insertions(+), 13 deletions(-)

