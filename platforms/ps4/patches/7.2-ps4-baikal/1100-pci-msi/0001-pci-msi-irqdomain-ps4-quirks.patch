diff --git a/arch/x86/kernel/apic/io_apic.c b/arch/x86/kernel/apic/io_apic.c
index 7d7175d01228884f669f7cf3d2890a7eea817695..7e269deab9832123d2205f151ff2675afabff410 100644
--- a/arch/x86/kernel/apic/io_apic.c
+++ b/arch/x86/kernel/apic/io_apic.c
@@ -2355,21 +2355,17 @@ static int io_apic_get_redir_entries(int ioapic)
 
 unsigned int arch_dynirq_lower_bound(unsigned int from)
 {
-	unsigned int ret;
-
 	/*
 	 * dmar_alloc_hwirq() may be called before setup_IO_APIC(), so use
 	 * gsi_top if ioapic_dynirq_base hasn't been initialized yet.
 	 */
-	ret = ioapic_dynirq_base ? : gsi_top;
-
+	if (!ioapic_initialized)
+		return gsi_top;
 	/*
-	 * For DT enabled machines ioapic_dynirq_base is irrelevant and
-	 * always 0. gsi_top can be 0 if there is no IO/APIC registered.
-	 * 0 is an invalid interrupt number for dynamic allocations. Return
-	 * @from instead.
+	 * For DT enabled machines ioapic_dynirq_base is irrelevant and not
+	 * updated. So simply return @from if ioapic_dynirq_base == 0.
 	 */
-	return ret ? : from;
+	return ioapic_dynirq_base ? : from;
 }
 
 #ifdef CONFIG_X86_32
diff --git a/arch/x86/kernel/apic/vector.c b/arch/x86/kernel/apic/vector.c
index bddc544653999a28bc1c87f35a5c15b45bf2cf13..7907e11ab4eef6549bc12095de8a07d7ec319490 100644
--- a/arch/x86/kernel/apic/vector.c
+++ b/arch/x86/kernel/apic/vector.c
@@ -689,6 +689,15 @@ int x86_fwspec_is_hpet(struct irq_fwspec *fwspec)
 	return 0;
 }
 
+int x86_fwspec_is_aeolia(struct irq_fwspec *fwspec)
+{
+	if (is_fwnode_irqchip(fwspec->fwnode)) {
+		const char *fwname = fwnode_get_name(fwspec->fwnode);
+		return fwname && !strncmp(fwname, "Aeolia-MSI", 10);
+	}
+	return 0;
+}
+
 static int x86_vector_select(struct irq_domain *d, struct irq_fwspec *fwspec,
 			     enum irq_domain_bus_token bus_token)
 {
@@ -700,7 +709,7 @@ static int x86_vector_select(struct irq_domain *d, struct irq_fwspec *fwspec,
 	if (apic_id_valid(32768))
 		return 0;
 
-	return x86_fwspec_is_ioapic(fwspec) || x86_fwspec_is_hpet(fwspec);
+	return x86_fwspec_is_ioapic(fwspec) || x86_fwspec_is_hpet(fwspec) || x86_fwspec_is_aeolia(fwspec);
 }
 
 static const struct irq_domain_ops x86_vector_domain_ops = {
@@ -1023,7 +1032,7 @@ void apic_ack_edge(struct irq_data *irqd)
 	apic_ack_irq(irqd);
 }
 
-static void x86_vector_msi_compose_msg(struct irq_data *data,
+void x86_vector_msi_compose_msg(struct irq_data *data,
 				       struct msi_msg *msg)
 {
        __irq_msi_compose_msg(irqd_cfg(data), msg, false);
