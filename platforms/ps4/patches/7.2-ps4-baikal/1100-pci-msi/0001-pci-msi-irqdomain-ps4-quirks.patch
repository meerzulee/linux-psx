 };
 
+struct msi_msg;
+void x86_vector_msi_compose_msg(struct irq_data *data,
+				       struct msi_msg *msg);
+
 /*
  * Pointer to the local APIC driver in use on this system (there's
  * always just one such driver in use - the kernel decides via an
