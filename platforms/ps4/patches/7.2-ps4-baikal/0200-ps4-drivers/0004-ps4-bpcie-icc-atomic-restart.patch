From: Linux psX contributors <noreply@ps4-linux>
Subject: [PATCH] ps4: register atomic Baikal restart and refuse sleeping fallback

The normal x86 restart chain stops CPUs, APICs and timers before calling
restart handlers and the emergency_restart fallback. The existing PS4
fallback forwards Baikal requests to bpcie_icc_cmd(), which locks a mutex
and sleeps while polling a jiffies deadline. It cannot safely run there.
The Baikal-specific static icc_reboot() was never registered either.

Extend the atomic transport introduced by suds-mcduff in PR #4 without
rewriting that contribution. Register a Baikal SYS_OFF_MODE_RESTART handler
using the existing fixed six-byte ICC reset command. Both terminal sends
reject non-terminal, forced, kexec, IRQ-enabled, mutex-owned and pending
states before touching the mailbox. Never steal an unfinished request.
Retain the existing mailbox-empty check and one send, followed by a bounded
busy wait. Log submission/refusal without claiming physical completion.

Refuse Baikal's legacy emergency/fallback route instead of sleeping or
sending the command twice. Aeolia/Belize fallback behavior is unchanged.
Emergency restart without the normal shutdown sequence remains unsupported.

This does not make retained UVD shutdown return, establish DMA quiescence,
or change any device teardown. The separate UVD lifecycle exception must
also admit an explicitly enabled healthy ordinary restart. No hardware
acceptance is claimed for this patch.

Original atomic power-off contribution: PR #4,
commit 16c43fcd090c95669374c27cbb2df835326d259a (suds-mcduff).
---
diff --git a/drivers/ps4/ps4-bpcie-icc.c b/drivers/ps4/ps4-bpcie-icc.c
--- a/drivers/ps4/ps4-bpcie-icc.c
+++ b/drivers/ps4/ps4-bpcie-icc.c
@@ -1,35 +1,36 @@
 #define DEBUG
 
 #include <linux/kernel.h>
 #include <linux/sched.h>
 #include <linux/wait.h>
 #include <linux/pci.h>
 #include <linux/interrupt.h>
 #include <linux/delay.h>
 #include <linux/fs.h>
 #include <linux/uaccess.h>
 #include <linux/reboot.h>
+#include <linux/kexec.h>
 #include <asm/ps4.h>
 #include "baikal.h"
 
 #define bpcie_icc_dev abpcie_icc_dev
 
 /* There should normally be only one Baikal device in a system. This allows
  * other kernel code in unrelated subsystems to issue icc requests without
  * having to get a reference to the device. */
 static struct bpcie_dev *icc_sc;
 
 DEFINE_MUTEX(bcpie_icc_mutex);
 /* The ICC message passing interface seems to be potentially designed to
  * support multiple outstanding requests at once, but the original PS4 OS never
  * does this, so we don't either. */
 
 #define REQUEST (sc->icc.spm + BPCIE_SPM_ICC_REQUEST)
 #define REPLY (sc->icc.spm + BPCIE_SPM_ICC_REPLY)
 
 int icc_i2c_init(struct bpcie_dev *sc);
 void icc_i2c_remove(struct bpcie_dev *sc);
 int icc_pwrbutton_init(struct bpcie_dev *sc);
 void icc_pwrbutton_remove(struct bpcie_dev *sc);
 void icc_pwrbutton_trigger(struct bpcie_dev *sc, int state);
 
@@ -298,63 +299,68 @@
 
 	return sc->icc.reply.length - ICC_HDR_SIZE;
 }
 
 int bpcie_icc_cmd(u8 major, u16 minor, const void *data, u16 length,
 		   void *reply, u16 reply_length)
 {
 	int ret;
 
 	mutex_lock(&bcpie_icc_mutex);
 	if (!icc_sc) {
 		pr_err("icc: not ready\n");
 		ret = -EAGAIN;
 		goto out_unlock;
 	}
 	ret = _bpcie_icc_cmd(icc_sc, major, minor, data, length, reply, reply_length,
 		       false);
 out_unlock:
 	mutex_unlock(&bcpie_icc_mutex);
 	return ret;
 }
 EXPORT_SYMBOL_GPL(bpcie_icc_cmd);
 
 /*
- * Send a request without waiting for the reply, for the power-off path.
- * sys-off handlers run in atomic context, so do not lock or sleep here.
- * Normal shutdown stops the other CPUs; reject forced shutdown and any
- * pending reply before changing the shared request or reply state.
+ * Send one terminal request without waiting for a reply. Both sys-off
+ * callbacks run after normal x86 machine_shutdown stopped the other CPUs.
+ * Reject non-terminal, forced and kexec paths and a stopped command owner:
+ * reply_pending alone misses a sender stopped before publishing that flag.
+ * Never lock, sleep, process IRQs or poll jiffies in this atomic path.
  */
 static int bpcie_icc_send_nowait(u8 major, u16 minor, const void *data,
 				 u16 length)
 {
 	struct bpcie_dev *sc = READ_ONCE(icc_sc);
 	int ret;
 
 	if (!sc)
 		return -EAGAIN;
 
-	if (reboot_force || READ_ONCE(sc->icc.reply_pending))
+	if (system_state != SYSTEM_POWER_OFF && system_state != SYSTEM_RESTART)
+		return -EINVAL;
+	if (reboot_force || kexec_in_progress || !irqs_disabled() ||
+	    mutex_is_locked(&bcpie_icc_mutex) ||
+	    READ_ONCE(sc->icc.reply_pending))
 		return -EBUSY;
 
 	sc->icc.reply_buffer = NULL;
 	sc->icc.reply_length = 0;
 	ret = icc_write_request(sc, major, minor, data, length);
 	if (ret)
 		return ret;
 
 	iowrite32(BPCIE_ICC_SEND | BPCIE_ICC_ACK,
 		  sc->bar2 + BPCIE_REG_ICC_STATUS);
 	iowrite32(BPCIE_ICC_SEND, sc->bar2 + BPCIE_REG_ICC_DOORBELL);
 	return 0;
 }
 
 static void bpcie_init_usb(struct bpcie_dev *sc, int usb_no) {
 	u32 value_to_write;
 	void __iomem *addr;
 	u32 offset;
 
 	offset = usb_no ? 0x68 : 0x64;
 
 	addr = sc->bar2 + BPCIE_USB_BASE + offset;
 	value_to_write = ioread32(addr) | 1;
 	iowrite32(value_to_write, addr);
@@ -454,83 +460,98 @@
 				1, 0x00, 4, 1, 0xbf,
 				2, 0xff, 5, 1, 0xff,
 				2, 0x00, 5, 1, 0xff,
 	};
 	int ret;
 	// test: get FW version
 	ret = bpcie_icc_cmd(2, 6, NULL, 0, reply, 0x30);
 	printk("ret=%d, reply %02x %02x %02x %02x %02x %02x %02x %02x\n", ret,
 		reply[0], reply[1], reply[2], reply[3],
 		reply[4], reply[5], reply[6], reply[7]);
 	ret = bpcie_icc_cmd(1, 0, &svc, 1, reply, 0x30);
 	printk("ret=%d, reply %02x %02x %02x %02x %02x %02x %02x %02x\n", ret,
 		reply[0], reply[1], reply[2], reply[3],
 		reply[4], reply[5], reply[6], reply[7]);
 
 	/* Set the LED to something nice */
 	ret = bpcie_icc_cmd(9, 0x20, led_config, ARRAY_SIZE(led_config), reply, 0x30);
 	printk("ret=%d, reply %02x %02x %02x %02x %02x %02x %02x %02x\n", ret,
 		reply[0], reply[1], reply[2], reply[3],
 		reply[4], reply[5], reply[6], reply[7]);
 }
 
 static void icc_shutdown(void)
 {
-	uint8_t command[] = {
-		0, 0, 2, 0, 1, 0
-	};
+	static const u8 command[] = { 0, 0, 2, 0, 1, 0 };
+	int ret;
+
 	if (bpcie_status() != 1)
 		return;
-	if (bpcie_icc_send_nowait(4, 1, command, sizeof(command)))
+	ret = bpcie_icc_send_nowait(4, 1, command, sizeof(command));
+	if (ret) {
+		pr_emerg("PS4_ICC_POWEROFF refused error=%d; request not sent\n", ret);
 		return;
+	}
+	pr_emerg("PS4_ICC_POWEROFF submitted; waiting at most 3000 ms\n");
 	mdelay(3000);
-	WARN_ON(1);
+	pr_emerg("PS4_ICC_POWEROFF returned; physical power-off unobserved\n");
 }
 
 /*
  * Run the ICC power-off before ACPI's S5 handler. On Baikal the ACPI S5
  * handler neither powers the console off nor returns, so a default-priority
  * pm_power_off is never reached. If the ICC request fails, icc_shutdown()
  * returns and the remaining handlers still run.
  */
 static struct sys_off_handler *icc_power_off_handler;
+static struct sys_off_handler *icc_restart_handler;
 
 static int icc_power_off(struct sys_off_data *data)
 {
 	icc_shutdown();
 	return NOTIFY_DONE;
 }
 
-static void icc_reboot(void)
-{
-	uint8_t command[] = {
-		0, 1, 2, 0, 1, 0
-	};
+/* The registered restart chain runs after CPUs/APIC/timers stop. Do not
+ * enter bpcie_icc_cmd(): its mutex and reply wait require a live scheduler.
+ */
+static int icc_restart(struct sys_off_data *data)
+{
+	static const u8 command[] = { 0, 1, 2, 0, 1, 0 };
+	int ret;
+
 	if (bpcie_status() != 1)
-		return;
-	bpcie_icc_cmd(4, 1, command, sizeof(command), NULL, 0);
+		return NOTIFY_DONE;
+	ret = bpcie_icc_send_nowait(4, 1, command, sizeof(command));
+	if (ret) {
+		pr_emerg("PS4_ICC_RESTART refused error=%d; request not sent\n", ret);
+		return NOTIFY_STOP;
+	}
+	pr_emerg("PS4_ICC_RESTART submitted; waiting at most 3000 ms\n");
 	mdelay(3000);
-	WARN_ON(1);
+	pr_emerg("PS4_ICC_RESTART returned; physical restart unobserved\n");
+	/* Do not let another handler submit a second reset after this request. */
+	return NOTIFY_STOP;
 }
 
 static void *ioctl_tmp_buf = NULL;
 
  static long icc_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
  {
  	int ret;
  	void __user *uap = (void __user *)arg;
  	switch (cmd) {
  	case ICC_IOCTL_CMD: {
  		struct icc_cmd cmd;
  		int reply_len;
  		ret = copy_from_user(&cmd, uap, sizeof(cmd));
  		if (ret) {
  			ret = -EFAULT;
  			break;
  		}
  		ret = copy_from_user(ioctl_tmp_buf, cmd.data, cmd.length);
  		if (ret) {
  			ret = -EFAULT;
  			break;
  		}
  		reply_len = bpcie_icc_cmd(cmd.major, cmd.minor, ioctl_tmp_buf,
  			cmd.length, ioctl_tmp_buf, cmd.reply_length);
@@ -629,83 +650,95 @@
 	mutex_unlock(&bcpie_icc_mutex);
 
 	ret = icc_i2c_init(sc);
 	if (ret) {
 		sc_err("icc: i2c init failed: %d\n", ret);
 		goto unassign_global;
 	}
 	resetBtWlan();
 	resetUsbPort();
 
 	ret = icc_pwrbutton_init(sc);
 	/* Not fatal */
 	if (ret)
 		sc_err("icc: pwrbutton init failed: %d\n", ret);
 
 	do_icc_init();
 	icc_power_off_handler = register_sys_off_handler(SYS_OFF_MODE_POWER_OFF,
 							 SYS_OFF_PRIO_FIRMWARE + 1,
 							 icc_power_off, NULL);
 	if (IS_ERR(icc_power_off_handler)) {
 		sc_err("icc: power-off handler registration failed: %ld\n",
 		       PTR_ERR(icc_power_off_handler));
 		icc_power_off_handler = NULL;
 	}
+	icc_restart_handler = register_sys_off_handler(SYS_OFF_MODE_RESTART,
+						       SYS_OFF_PRIO_FIRMWARE + 1,
+						       icc_restart, NULL);
+	if (IS_ERR(icc_restart_handler)) {
+		sc_err("icc: restart handler registration failed: %ld\n",
+		       PTR_ERR(icc_restart_handler));
+		icc_restart_handler = NULL;
+	}
 
 	ioctl_tmp_buf = kzalloc(1 << 16, GFP_KERNEL);
  	if (!ioctl_tmp_buf) {
  		sc_err("icc: alloc ioctl_tmp_buf failed\n");
  		goto done;
  	}
  	ret = register_chrdev(ICC_MAJOR, "icc", &icc_fops);
  	if (ret) {
  		sc_err("icc: register_chrdev failed: %d\n", ret);
  		goto done;
  	}
  done:
 
 	return 0;
 
 unassign_global:
 	mutex_lock(&bcpie_icc_mutex);
 	iowrite32(0, sc->bar2 + BPCIE_REG_ICC_IRQ_MASK);
 	icc_sc = NULL;
 	mutex_unlock(&bcpie_icc_mutex);
 free_irq:
 	free_irq(bpcie_irqnum(sc, BPCIE_SUBFUNC_ICC), sc);
 iounmap:
 	iounmap(sc->icc.spm);
 release_spm:
 	release_mem_region(sc->icc.spm_base, BPCIE_SPM_ICC_SIZE);
 release_icc:
 	release_mem_region(pci_resource_start(sc->pdev, 4) +
 			   BPCIE_RGN_ICC_BASE, BPCIE_RGN_ICC_SIZE);
 	return ret;
 }
 
 void bpcie_icc_remove(struct bpcie_dev *sc)
 {
 	sc_err("bpcie_icc_remove: shouldn't normally be called\n");
+	if (icc_restart_handler) {
+		unregister_sys_off_handler(icc_restart_handler);
+		icc_restart_handler = NULL;
+	}
 	if (icc_power_off_handler) {
 		unregister_sys_off_handler(icc_power_off_handler);
 		icc_power_off_handler = NULL;
 	}
 	icc_pwrbutton_remove(sc);
 	icc_i2c_remove(sc);
 	mutex_lock(&bcpie_icc_mutex);
 	iowrite32(0, sc->bar2 + BPCIE_REG_ICC_IRQ_MASK);
 	icc_sc = NULL;
 	mutex_unlock(&bcpie_icc_mutex);
 	free_irq(bpcie_irqnum(sc, BPCIE_SUBFUNC_ICC), sc);
 	iounmap(sc->icc.spm);
 	release_mem_region(sc->icc.spm_base, BPCIE_SPM_ICC_SIZE);
 	release_mem_region(pci_resource_start(sc->pdev, 2) +
 			   BPCIE_RGN_ICC_BASE, BPCIE_RGN_ICC_SIZE);
 }
 
 #ifdef CONFIG_PM
 void bpcie_icc_suspend(struct bpcie_dev *sc, pm_message_t state)
 {
 }
 
 void bpcie_icc_resume(struct bpcie_dev *sc)
 {
diff --git a/drivers/ps4/ps4-apcie-icc.c b/drivers/ps4/ps4-apcie-icc.c
--- a/drivers/ps4/ps4-apcie-icc.c
+++ b/drivers/ps4/ps4-apcie-icc.c
@@ -373,48 +373,56 @@
 	/* Set the LED to something nice */
 	ret = apcie_icc_cmd(9, 0x20, led_config, ARRAY_SIZE(led_config), reply, 0x30);
 	printk("ret=%d, reply %02x %02x %02x %02x %02x %02x %02x %02x\n", ret,
 		reply[0], reply[1], reply[2], reply[3],
 		reply[4], reply[5], reply[6], reply[7]);
 }
 
 static void icc_shutdown(void)
 {
 	uint8_t command[] = {
 		0, 0, 2, 0, 1, 0
 	};
 	if (apcie_status() != 1)
 		return;
 	apcie_icc_cmd(4, 1, command, sizeof(command), NULL, 0);
 	mdelay(3000);
 	WARN_ON(1);
 }
 
 void icc_reboot(void)
 {
 	uint8_t command[] = {
 		0, 1, 2, 0, 1, 0
 	};
+	/* Normal Baikal restart uses its registered atomic sys-off handler.
+	 * The x86 emergency/fallback hook has no safe sleeping ICC context;
+	 * it must neither forward to bpcie_icc_cmd nor resend a terminal request.
+	 */
+	if (bpcie_status() == 1) {
+		pr_emerg("PS4_ICC_RESTART legacy/emergency fallback refused on Baikal\n");
+		return;
+	}
 	if (apcie_status() != 1)
 		return;
 	apcie_icc_cmd(4, 1, command, sizeof(command), NULL, 0);
 	mdelay(3000);
 	WARN_ON(1);
 }
 
 static void *ioctl_tmp_buf = NULL;
 
  static long icc_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
  {
  	int ret;
  	void __user *uap = (void __user *)arg;
  	switch (cmd) {
  	case ICC_IOCTL_CMD: {
  		struct icc_cmd cmd;
  		int reply_len;
  		ret = copy_from_user(&cmd, uap, sizeof(cmd));
  		if (ret) {
  			ret = -EFAULT;
  			break;
  		}
  		ret = copy_from_user(ioctl_tmp_buf, cmd.data, cmd.length);
  		if (ret) {
