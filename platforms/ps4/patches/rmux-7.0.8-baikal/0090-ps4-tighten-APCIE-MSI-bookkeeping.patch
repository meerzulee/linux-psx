 	sc_dev = pci_get_slot(dev->bus, sc_devfn);
@@ -365,10 +401,7 @@ int apcie_assign_irqs(struct pci_dev *dev, int nvec)
 	/* IRQs "come from" function 4 as far as the IOMMU/system see */
