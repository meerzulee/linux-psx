From 4e80f46735535e7737c542515f2252706d268465 Mon Sep 17 00:00:00 2001
From: rmuxnet <armandas.kvietkus@proton.me>
Date: Tue, 5 May 2026 12:36:26 +0200
Subject: [PATCH] ps4: tighten APCIE MSI bookkeeping
MIME-Version: 1.0
Content-Type: multipart/mixed; boundary="------------false"

This is a multi-part message in MIME format.
--------------false
Content-Type: text/plain; charset=UTF-8; format=fixed
Content-Transfer-Encoding: 8bit


Stop mutating the global Aeolia MSI domain info and controller state at runtime by giving each APCIE instance its own irqchip/domain context.

Cache the composed MSI data per allocated virq so compose_msg no longer scans the irq_map array, and free the matching MSI descriptor range when irq_domain_alloc_irqs fails.

Also publish APCIE readiness with READ_ONCE/WRITE_ONCE so dependent PS4 drivers do not observe stale initialization state.

Signed-off-by: rmuxnet <armandas.kvietkus@proton.me>
---
 arch/x86/platform/ps4/ps4.c |   2 +-
 drivers/ps4/aeolia.h        |   3 +
 drivers/ps4/ps4-apcie.c     | 126 ++++++++++++++++++++++++------------
 3 files changed, 87 insertions(+), 44 deletions(-)


--------------false
Content-Type: text/x-patch; name="0090-ps4-tighten-APCIE-MSI-bookkeeping.patch"
Content-Transfer-Encoding: 8bit
Content-Disposition: attachment; filename="0090-ps4-tighten-APCIE-MSI-bookkeeping.patch"

diff --git a/arch/x86/platform/ps4/ps4.c b/arch/x86/platform/ps4/ps4.c
index 8a3a11263724836cacbd1bec07c8b374df5e5150..6137cc27a58f18a368af9a9645116b30767fc0ec 100644
--- a/arch/x86/platform/ps4/ps4.c
+++ b/arch/x86/platform/ps4/ps4.c
@@ -52,7 +52,7 @@ int apcie_status(void)
 {
 	if (!is_ps4)
 		return -ENODEV;
-	return apcie_initialized;
+	return READ_ONCE(apcie_initialized);
 }
 EXPORT_SYMBOL_GPL(apcie_status);
 
diff --git a/drivers/ps4/aeolia.h b/drivers/ps4/aeolia.h
index 2551003e27ebf8d72dbb196974996957c9d295e7..0d9bda8df0cd04c8396d3ab46623cbe09cf64087 100644
--- a/drivers/ps4/aeolia.h
+++ b/drivers/ps4/aeolia.h
@@ -5,6 +5,8 @@
 #include <linux/pci.h>
 #include <linux/i2c.h>
 
+struct apcie_msi_domain_ctx;
+
 enum aeolia_func_id {
 	AEOLIA_FUNC_ID_ACPI = 0,
 	AEOLIA_FUNC_ID_GBE,
@@ -142,6 +144,7 @@ struct apcie_icc_dev {
 struct apcie_dev {
 	struct pci_dev *pdev;
 	struct irq_domain *irqdomain;
+	struct apcie_msi_domain_ctx *msi_domain_ctx;
 	void __iomem *bar0;
 	void __iomem *bar2;
 	void __iomem *bar4;
diff --git a/drivers/ps4/ps4-apcie.c b/drivers/ps4/ps4-apcie.c
