From e64286643ecbe78cc95d2bc58ca5faf236365c17 Mon Sep 17 00:00:00 2001
From: rmuxnet <armandas.kvietkus@proton.me>
Date: Fri, 15 May 2026 10:49:30 +0000
Subject: [PATCH] drm/amdgpu: gmc7: report correct VRAM type for PS4
 Liverpool/Gladius
MIME-Version: 1.0
Content-Type: multipart/mixed; boundary="------------false"

This is a multi-part message in MIME format.
--------------false
Content-Type: text/plain; charset=UTF-8; format=fixed
Content-Transfer-Encoding: 8bit


Liverpool and Gladius APUs use unified GDDR5 memory.  Report the
correct type instead of UNKNOWN so userspace tooling displays
accurate memory information.
---
 drivers/gpu/drm/amd/amdgpu/gmc_v7_0.c | 4 ++++
 1 file changed, 4 insertions(+)


--------------false
Content-Type: text/x-patch; name="0121-drm-amdgpu-gmc7-report-correct-VRAM-type-for-PS4-Liv.patch"
Content-Transfer-Encoding: 8bit
Content-Disposition: attachment; filename="0121-drm-amdgpu-gmc7-report-correct-VRAM-type-for-PS4-Liv.patch"

diff --git a/drivers/gpu/drm/amd/amdgpu/gmc_v7_0.c b/drivers/gpu/drm/amd/amdgpu/gmc_v7_0.c
index d31e0cf6e06a7be57967c01f20018353b953fb12..543dadee4a64a4e7c06c8936b4efcec38a81da2e 100644
--- a/drivers/gpu/drm/amd/amdgpu/gmc_v7_0.c
+++ b/drivers/gpu/drm/amd/amdgpu/gmc_v7_0.c
@@ -1009,6 +1009,10 @@ static int gmc_v7_0_sw_init(struct amdgpu_ip_block *ip_block)
 
 	if (adev->flags & AMD_IS_APU) {
 		adev->gmc.vram_type = AMDGPU_VRAM_TYPE_UNKNOWN;
+		/* PS4 Liverpool/Gladius use unified GDDR5 */
+		if (adev->asic_type == CHIP_LIVERPOOL ||
+		    adev->asic_type == CHIP_GLADIUS)
+			adev->gmc.vram_type = AMDGPU_VRAM_TYPE_GDDR5;
 	} else {
 		u32 tmp = RREG32(mmMC_SEQ_MISC0);
 

--------------false--


