diff --git a/drivers/iommu/amd/init.c b/drivers/iommu/amd/init.c
index f3fd7f39efb488893b8c4cda20b504124ebc9b89..ad1c12d8705b34cd4dc00d99dd35c9eba3cc0a37 100644
--- a/drivers/iommu/amd/init.c
+++ b/drivers/iommu/amd/init.c
@@ -3093,6 +3093,7 @@ static void __init free_iommu_resources(void)
 	free_pci_segments();
 }
 
+#ifndef CONFIG_X86_PS4 // TODO this should detect ps4-ness at runtime
 /* SB IOAPIC is always on this device in AMD systems */
 #define IOAPIC_SB_DEVID		((0x00 << 8) | PCI_DEVFN(0x14, 0))
 
@@ -3144,6 +3145,7 @@ static bool __init check_ioapic_information(void)
 
 	return ret;
 }
+#endif
 
 static void __init free_dma_resources(void)
 {
@@ -3269,8 +3271,10 @@ static int __init early_amd_iommu_init(void)
 	if (!is_kdump_kernel() || amd_iommu_disabled)
 		disable_iommus();
 
+	#ifndef CONFIG_X86_PS4
 	if (amd_iommu_irq_remap)
 		amd_iommu_irq_remap = check_ioapic_information();
+	#endif
 
 	if (amd_iommu_irq_remap) {
 		struct amd_iommu_pci_seg *pci_seg;
diff --git a/drivers/iommu/amd/iommu.c b/drivers/iommu/amd/iommu.c
index 760d5f4623b553614c7f42c1ef1ae849a518f2c7..39556f25fafaee2d2121586dea8f3ac16a2b7937 100644
--- a/drivers/iommu/amd/iommu.c
+++ b/drivers/iommu/amd/iommu.c
@@ -3915,9 +3915,12 @@ static int irq_remapping_select(struct irq_domain *d, struct irq_fwspec *fwspec,
 		devid = get_ioapic_devid(fwspec->param[0]);
 	else if (x86_fwspec_is_hpet(fwspec))
 		devid = get_hpet_devid(fwspec->param[0]);
+	else if(x86_fwspec_is_aeolia(fwspec))
+		devid = fwspec->param[0];
 
 	if (devid < 0)
 		return 0;
+	pr_err("Remapping Selected: %x\n", devid);
 	iommu = __rlookup_amd_iommu((devid >> 16), (devid & 0xffff));
 
 	return iommu && iommu->ir_domain == d;

--------------false--


