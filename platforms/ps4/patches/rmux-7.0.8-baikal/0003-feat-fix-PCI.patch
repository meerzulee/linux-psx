diff --git a/drivers/pci/probe.c b/drivers/pci/probe.c
index bccc7a4bdd794384b7877d453c7989941471c999..4e1ca58b9f81bf729d79e02c014501540ccc3bbc 100644
--- a/drivers/pci/probe.c
+++ b/drivers/pci/probe.c
@@ -2853,6 +2853,9 @@ static int only_one_child(struct pci_bus *bus)
 	return 0;
 }
 
+// It can be arbitrary (above 2). Freebsd uses 20, so use that too.
+#define AEOLIA_SLOT_NUM 20
+
 /**
  * pci_scan_slot - Scan a PCI slot on a bus for devices
  * @bus: PCI bus to scan
@@ -2869,10 +2872,26 @@ int pci_scan_slot(struct pci_bus *bus, int devfn)
 	struct pci_dev *dev;
 	int fn = 0, nr = 0;
 
+	u32 l;
+
 	if (only_one_child(bus) && (devfn > 0))
 		return 0; /* Already scanned the entire slot */
 
+	// skip phantom Aeolia devices that bleed through the PCI space
+	if (PCI_SLOT(devfn) != AEOLIA_SLOT_NUM &&
+	    pci_bus_read_dev_vendor_id(bus, devfn, &l, 60*1000) &&
+	    (l & 0xffff) == PCI_VENDOR_ID_SONY) {
+		return 0;
+	}
+
 	do {
+		if (PCI_SLOT(devfn) != AEOLIA_SLOT_NUM &&
+		    pci_bus_read_dev_vendor_id(bus, devfn + fn, &l, 60*1000) &&
+		    (l & 0xffff) == PCI_VENDOR_ID_SONY) {
+				fn = next_fn(bus, dev, fn);
+			continue;
+		}
+
 		dev = pci_scan_single_device(bus, devfn + fn);
 		if (dev) {
 			if (!pci_dev_is_added(dev))

