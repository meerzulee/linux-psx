From: rmuxnet <armandas.kvietkus@proton.me>
Date: Sat, 22 Aug 2026 21:32:02 +0200
Subject: [PATCH] amdgpu: ps4_bridge: drop vendor guard exp

---
 drivers/gpu/drm/amd/amdgpu/ps4_bridge.c | 5 -----
 1 file changed, 5 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/ps4_bridge.c b/drivers/gpu/drm/amd/amdgpu/ps4_bridge.c
index 261a70e2646f7a4ce02a86de8d406e36f2b30a45..eaae94044e99f7b5e175fda91048824825def89d 100644
--- a/drivers/gpu/drm/amd/amdgpu/ps4_bridge.c
+++ b/drivers/gpu/drm/amd/amdgpu/ps4_bridge.c
@@ -818,11 +818,6 @@ static void ps4_bridge_enable(struct drm_bridge *bridge)
 		goto out;
 	}
 
-	if (pdev->vendor != PCI_VENDOR_ID_ATI) {
-		DRM_ERROR("Invalid vendor: %04x", pdev->vendor);
-		goto out;
-	}
-
 	DRM_DEBUG_KMS("ps4_bridge_enable (mode: %d)\n", mn_bridge->mode);
 
 	/* Here come the dragons */
