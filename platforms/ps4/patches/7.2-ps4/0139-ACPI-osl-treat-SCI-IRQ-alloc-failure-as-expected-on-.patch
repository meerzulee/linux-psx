From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rmuxnet <armandas.kvietkus@proton.me>
Date: Tue, 7 Jul 2026 00:19:06 +0200
Subject: [PATCH] ACPI: osl: treat SCI IRQ alloc failure as expected on
 PS4/Aeolia

---
 drivers/acpi/osl.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/drivers/acpi/osl.c b/drivers/acpi/osl.c
index ed2162a97bd2aa3f7c79706d238092a6b0399332..cfff42d764e0e74d510c67bb05f09b2b91714077 100644
--- a/drivers/acpi/osl.c
+++ b/drivers/acpi/osl.c
@@ -586,8 +586,12 @@ acpi_os_install_interrupt_handler(u32 gsi, acpi_osd_handler handler,
 	acpi_irq_context = context;
 	if (request_threaded_irq(irq, NULL, acpi_irq, IRQF_SHARED | IRQF_ONESHOT,
 			         "acpi", acpi_irq)) {
-		pr_err("SCI (IRQ%d) allocation failed\n", irq);
 		acpi_irq_handler = NULL;
+
+		if (memcmp(acpi_gbl_FADT.header.oem_id, "SIE   ", ACPI_OEM_ID_SIZE) == 0)
+			return AE_OK;
+
+		pr_err("SCI (IRQ%d) allocation failed\n", irq);
 		return AE_NOT_ACQUIRED;
 	}
 	acpi_sci_irq = irq;
