From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Niels Westphal (crashniels)" <nielswest@live.de>
Date: Thu, 10 Jul 2025 23:13:04 +0200
Subject: [PATCH] small cleanup on ahci

---
 drivers/ata/ahci.c             | 36 ++++++++++++++--------------------
 drivers/ata/ahci.h             |  1 +
 drivers/usb/host/xhci-aeolia.c |  1 +
 3 files changed, 17 insertions(+), 21 deletions(-)

diff --git a/drivers/ata/ahci.c b/drivers/ata/ahci.c
index 4e1ce0c8b602afcf19f5d633ce668ec25cbf19a5..9d63ba814ca2d8e36838627eb2ca6f2d272af23a 100644
--- a/drivers/ata/ahci.c
+++ b/drivers/ata/ahci.c
@@ -52,6 +52,7 @@ enum {
 enum board_ids {
 	/* board IDs by feature in alphabetical order */
 	board_ahci,
+	board_ahci_31bit_dma,
 	board_ahci_43bit_dma,
 	board_ahci_ign_iferr,
 	board_ahci_no_debounce_delay,
@@ -136,6 +137,13 @@ static const struct ata_port_info ahci_port_info[] = {
 		.udma_mask	= ATA_UDMA6,
 		.port_ops	= &ahci_ops,
 	},
+	[board_ahci_31bit_dma] = {
+		AHCI_HFLAGS	(AHCI_HFLAG_31BIT_ONLY),
+		.flags		= AHCI_FLAG_COMMON,
+		.pio_mask	= ATA_PIO4,
+		.udma_mask	= ATA_UDMA6,
+		.port_ops	= &ahci_ops,
+	},
 	[board_ahci_43bit_dma] = {
 		AHCI_HFLAGS	(AHCI_HFLAG_43BIT_ONLY),
 		.flags		= AHCI_FLAG_COMMON,
@@ -1583,19 +1591,18 @@ static const struct pci_device_id ahci_pci_tbl[] = {
 		/* Loongson */
 		PCI_VDEVICE(LOONGSON, 0x7a08),
 		.driver_data = board_ahci,
-
 	}, {
 		/* Sony PS4 Aeolia */
 		PCI_VDEVICE(SONY, PCI_DEVICE_ID_SONY_AEOLIA_AHCI),
-		.driver_data = board_ahci,
+		.driver_data = board_ahci_31bit_dma,
 	}, {
 		/* Sony PS4 Belize */
 		PCI_VDEVICE(SONY, PCI_DEVICE_ID_SONY_BELIZE_AHCI),
-		.driver_data = board_ahci,
+		.driver_data = board_ahci_31bit_dma,
 	}, {
 		/* Sony PS4 Baikal */
 		PCI_VDEVICE(SONY, PCI_DEVICE_ID_SONY_BAIKAL_AHCI),
-		.driver_data = board_ahci,
+		.driver_data = board_ahci_31bit_dma,
 	}, {
 		/* Generic, PCI class code for AHCI */
 		PCI_DEVICE_CLASS(PCI_CLASS_STORAGE_SATA_AHCI, 0xffffff),
@@ -2034,9 +2041,12 @@ static int ahci_configure_dma_masks(struct pci_dev *pdev,
 		dma_bits = 64;
 		if (hpriv->flags & AHCI_HFLAG_43BIT_ONLY)
 			dma_bits = 43;
+		if (hpriv->flags & AHCI_HFLAG_31BIT_ONLY)
+			dma_bits = 31;
 	} else {
 		dma_bits = 32;
 	}
+	dev_info(&pdev->dev, "DMA bits = %d\n", dma_bits);
 
 	/*
 	 * If the device fixup already set the dma_mask to some non-standard
@@ -2048,24 +2058,8 @@ static int ahci_configure_dma_masks(struct pci_dev *pdev,
 	if (pdev->dma_mask && pdev->dma_mask < DMA_BIT_MASK(32))
 		return 0;
 
-	#ifdef CONFIG_X86_PS4
-	if (pdev->vendor == PCI_VENDOR_ID_SONY) {
-		rc = dma_set_mask(&pdev->dev, DMA_BIT_MASK(31));
-		if (rc) {
-			dev_err(&pdev->dev, "31-bit DMA enable failed\n");
-			return rc;
-		}
-		rc = dma_set_coherent_mask(&pdev->dev, DMA_BIT_MASK(31));
-		if (rc) {
-			dev_err(&pdev->dev,
-				"31-bit consistent DMA enable failed\n");
-			return rc;
-		}
-		return 0;
-	}
-	#endif
-
 	rc = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(dma_bits));
+	dev_info(&pdev->dev, "DMA enable\n");
 	if (rc)
 		dev_err(&pdev->dev, "DMA enable failed\n");
 	return rc;
diff --git a/drivers/ata/ahci.h b/drivers/ata/ahci.h
index b663e35361c743a2aa9dbabfea16ab72487f4d4b..3df840a36cd61849554dcbae664b2d305e0ff079 100644
--- a/drivers/ata/ahci.h
+++ b/drivers/ata/ahci.h
@@ -247,6 +247,7 @@ enum {
 	AHCI_HFLAG_43BIT_ONLY		= BIT(27), /* 43bit DMA addr limit */
 	AHCI_HFLAG_INTEL_PCS_QUIRK	= BIT(28), /* apply Intel PCS quirk */
 	AHCI_HFLAG_ATAPI_DMA_QUIRK	= BIT(29), /* force ATAPI to use DMA */
+	AHCI_HFLAG_31BIT_ONLY 		= BIT(30), /* 31bit DMA addr limit */
 
 	/* ap->flags bits */
 
diff --git a/drivers/usb/host/xhci-aeolia.c b/drivers/usb/host/xhci-aeolia.c
index 509b0a19c4df988a8f905d1e2997c1a15c015653..14037f8d7aa62e8c39d44877d5f79399778d6a5f 100644
--- a/drivers/usb/host/xhci-aeolia.c
+++ b/drivers/usb/host/xhci-aeolia.c
@@ -150,6 +150,7 @@ static void xhci_aeolia_remove_one(struct pci_dev *dev, int index)
 #define DRV_VERSION	"3.0"
 #define DRV_NAME	"ahci"
 static const struct ata_port_info ahci_port_info = {
+	AHCI_HFLAGS	(AHCI_HFLAG_31BIT_ONLY),
 	.flags		= AHCI_FLAG_COMMON,
 	.pio_mask	= ATA_PIO4,
 	.udma_mask	= ATA_UDMA6,
