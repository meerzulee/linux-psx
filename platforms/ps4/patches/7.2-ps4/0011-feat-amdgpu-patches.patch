+#define C420SET 0x70c2
+#define OUTWSET 0x70c3
+
+#define PKTENA 0x7202
+
+#define INFENA 0x7203
+#define INFENA_AVIEN BIT(6)
+
+#define AKESTA 0x7a84
+#define AKESTA_BUSY BIT(0)
+
+#define AKESRST 0x7a88
+
