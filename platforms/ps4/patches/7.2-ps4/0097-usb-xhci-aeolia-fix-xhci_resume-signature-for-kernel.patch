From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rmuxnet <armandas.kvietkus@proton.me>
Date: Mon, 11 May 2026 10:01:42 +0200
Subject: [PATCH] usb: xhci-aeolia: fix xhci_resume() signature for kernel 7.0

xhci_resume() in 7.0 takes (struct xhci_hcd *, bool power_lost,
bool is_auto_resume). The Aeolia branch was passing a single 0,
which is wrong and would cause a compile error or undefined behavior
depending on implicit conversion. Use (xhci, false, false) to match
the correct API.
---
 drivers/usb/host/xhci-aeolia.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/usb/host/xhci-aeolia.c b/drivers/usb/host/xhci-aeolia.c
index b18d9f786fd4368fa34b90a7729e6090a181e058..db6e1347708bd2db881c253f8f06f113b9265ea9 100644
--- a/drivers/usb/host/xhci-aeolia.c
+++ b/drivers/usb/host/xhci-aeolia.c
@@ -518,7 +518,7 @@ static int xhci_aeolia_suspend(struct device *dev)
 resume:
 	while (idx--) {
 		xhci = hcd_to_xhci(axhci->hcd[idx]);
-		xhci_resume(xhci, 0);
+		xhci_resume(xhci, false, false);
 	}
 	return retval;
 }
@@ -535,7 +535,7 @@ static int xhci_aeolia_resume(struct device *dev)
  		if(pdev->device != PCI_DEVICE_ID_SONY_AEOLIA_XHCI && idx == 1)
 			continue;
 		xhci = hcd_to_xhci(axhci->hcd[idx]);
-		retval = xhci_resume(xhci, 0);
+		retval = xhci_resume(xhci, false, false);
 		if (retval < 0)
 			return retval;
 	}
