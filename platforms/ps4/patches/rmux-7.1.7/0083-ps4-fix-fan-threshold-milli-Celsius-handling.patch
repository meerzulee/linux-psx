diff --git a/drivers/ps4/ps4-fan.c b/drivers/ps4/ps4-fan.c
index 87a4cfb6f1f8e3e2ee567f62607c0450346ff016..53f0d336b4f90c066f36a1d865f5620a81059b03 100644
--- a/drivers/ps4/ps4-fan.c
+++ b/drivers/ps4/ps4-fan.c
@@ -228,6 +228,8 @@ static int ps4_fan_write(struct device *dev, enum hwmon_sensor_types type,
 
 	if (type != hwmon_temp || channel != 0 || attr != hwmon_temp_crit)
 		return -EOPNOTSUPP;
+	if (val % 1000)
+		return -EINVAL;
 
 	mutex_lock(&priv->lock);
 	if (ps4_fan_cache_valid(priv->thresh_updated, priv->thresh_valid) &&

