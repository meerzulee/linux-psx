From 44c13dd71048d54637498a15450d438b9a39afed Mon Sep 17 00:00:00 2001
From: rmuxnet <armandas.kvietkus@proton.me>
Date: Wed, 1 Jul 2026 21:25:44 +0200
Subject: [PATCH] wifi: mt76x8: fix p2p cfg80211_ops signatures for 7.1 kernel

---
 .../MT6632/wlan/os/linux/gl_p2p_cfg80211.c    | 131 +++++++++++++++++-
 .../wlan/os/linux/include/gl_p2p_ioctl.h      |  36 ++++-
 2 files changed, 158 insertions(+), 9 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt76x8/drv_wlan/MT6632/wlan/os/linux/gl_p2p_cfg80211.c b/drivers/net/wireless/mediatek/mt76x8/drv_wlan/MT6632/wlan/os/linux/gl_p2p_cfg80211.c
