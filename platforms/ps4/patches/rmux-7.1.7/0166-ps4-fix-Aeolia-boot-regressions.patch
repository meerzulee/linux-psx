---
 arch/x86/pci/acpi.c            |  8 ++++++++
 drivers/acpi/osl.c             | 12 ++++++++++++
 drivers/iommu/amd/iommu.c      | 11 +++++++++++
 drivers/usb/host/xhci-aeolia.c |  2 +-
 kernel/irq/irqdomain.c         |  2 +-
