--- a/arch/x86/include/asm/irqdomain.h
+++ b/arch/x86/include/asm/irqdomain.h
@@ -12,6 +12,7 @@ enum {
 
 extern int x86_fwspec_is_ioapic(struct irq_fwspec *fwspec);
 extern int x86_fwspec_is_hpet(struct irq_fwspec *fwspec);
