From fa4dc08f5d79c5ea90b370d929ef6990986ad250 Mon Sep 17 00:00:00 2001
From: rmxunet <armandas.kvietkus@proton.me>
Date: Sat, 28 Mar 2026 14:33:01 +0100
Subject: [PATCH] ps4_bridge: Fix premature drm_kms_helper_poll_enable() call

ps4_bridge_register() is called before drm_kms_helper_poll_init(),
so poll_enabled is still false at that point, triggering a WARN_ON
and leaving the poll worker unscheduled. detect() is never called
after boot, breaking monitor hotplug and power-cycle entirely.

Remove the drm_kms_helper_poll_enable() calls from both the amdgpu
and radeon ps4_bridge_register(). amdgpu calls it itself at the
correct time and will pick up the connector->polled flags already set.

Signed-off-by: rmuxnet <armandas.kvietkus@proton.me>
---
 drivers/gpu/drm/amd/amdgpu/ps4_bridge.c | 2 --
 drivers/gpu/drm/radeon/ps4_bridge.c     | 2 --
 2 files changed, 4 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/ps4_bridge.c b/drivers/gpu/drm/amd/amdgpu/ps4_bridge.c
index 2511f6c05fb3db8dcd913b635e9013a02ff51f39..6483789b48e3807da69ed932b6baeb632bb03af0 100644
--- a/drivers/gpu/drm/amd/amdgpu/ps4_bridge.c
+++ b/drivers/gpu/drm/amd/amdgpu/ps4_bridge.c
@@ -836,7 +836,5 @@ int ps4_bridge_register(struct drm_connector *connector,
 		return -EINVAL;
 	}
 
-	drm_kms_helper_poll_enable(connector->dev);
-
 	return 0;
 }
diff --git a/drivers/gpu/drm/radeon/ps4_bridge.c b/drivers/gpu/drm/radeon/ps4_bridge.c
index e5d15dc5c209bcb7d1ad7115313f04f3e05f3667..751a01ad41c1905faa4a9039734e90f68402a8b8 100644
--- a/drivers/gpu/drm/radeon/ps4_bridge.c
+++ b/drivers/gpu/drm/radeon/ps4_bridge.c
@@ -777,7 +777,5 @@ int radeon_ps4_bridge_register(struct drm_connector *connector,
 		return -EINVAL;
 	}
 
-	drm_kms_helper_poll_enable(connector->dev);
-
 	return 0;
 }
