From e3c69f0727e81cf0a5e329adf3c37fe1e5a919c9 Mon Sep 17 00:00:00 2001
From: rmuxnet <armandas.kvietkus@proton.me>
Date: Mon, 20 Apr 2026 23:51:05 +0200
Subject: [PATCH] drm/amdgpu/ps4_bridge: gate bridge detect on live DPCD
 readiness

Belize can report monitor presence in TMONREG before the bridge AUX/DPCD side is actually ready. That lets amdgpu mark the sink connected too early, start DP link training against a half-awake bridge, and fail clock recovery.

Treat a successful DPCD read as the authoritative readiness signal for PS4 bridge detection, while keeping the existing TMONREG fallback for non-AUX paths.

Keep 1080p120 mode advertisement unchanged.
---
 drivers/gpu/drm/amd/amdgpu/ps4_bridge.c | 22 +++++++++++++---------
 1 file changed, 13 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/ps4_bridge.c b/drivers/gpu/drm/amd/amdgpu/ps4_bridge.c
index 7dd2993e6e8d2d24c471f43fa15fc45b7452c739..716a7aa602a9e09fd0c9ae2709185a9fd76098fc 100644
--- a/drivers/gpu/drm/amd/amdgpu/ps4_bridge.c
+++ b/drivers/gpu/drm/amd/amdgpu/ps4_bridge.c
@@ -1008,13 +1008,13 @@ enum drm_connector_status ps4_bridge_detect(struct drm_connector *connector,
 	present = !!(reg & TMONREG_MONITOR_PRESENT);
 	active = present && reg != TMONREG_MONITOR_POWERED_OFF;
 
-	if (active) {
-		if (dig_connector)
-			dig_connector->dp_sink_type = CONNECTOR_OBJECT_ID_DISPLAYPORT;
+	if (dig_connector)
+		dig_connector->dp_sink_type = CONNECTOR_OBJECT_ID_DISPLAYPORT;
+
+	if (amdgpu_connector->ddc_bus && amdgpu_connector->ddc_bus->has_aux)
+		dpcd_ret = amdgpu_atombios_dp_get_dpcd(amdgpu_connector);
 
-		if (amdgpu_connector->ddc_bus && amdgpu_connector->ddc_bus->has_aux)
-			dpcd_ret = amdgpu_atombios_dp_get_dpcd(amdgpu_connector);
-	} else if (dig_connector) {
+	if (dpcd_ret != 0 && dig_connector) {
 		dig_connector->dp_sink_type = CONNECTOR_OBJECT_ID_NONE;
 		dig_connector->dp_lane_count = 0;
 		dig_connector->dp_clock = 0;
@@ -1025,10 +1025,14 @@ enum drm_connector_status ps4_bridge_detect(struct drm_connector *connector,
 		      dig_connector ? dig_connector->dp_lane_count : 0,
 		      dig_connector ? dig_connector->dp_clock : 0);
 
-	if (active)
+	if (dpcd_ret == 0)
 		return connector_status_connected;
-	else
-		return connector_status_disconnected;
+
+	if (!amdgpu_connector->ddc_bus || !amdgpu_connector->ddc_bus->has_aux)
+		return active ? connector_status_connected :
+			connector_status_disconnected;
+
+	return connector_status_disconnected;
 }
 
 enum drm_mode_status ps4_bridge_mode_valid(struct drm_connector *connector,
