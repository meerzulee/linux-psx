From f3cf81faf054583c5b23762b5c67abf292334c40 Mon Sep 17 00:00:00 2001
From: "Niels Westphal (crashniels)" <nielswest@live.de>
Date: Fri, 4 Jul 2025 21:37:39 +0200
Subject: [PATCH] ahci_init_irq now returns void

---
 drivers/ata/ahci.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/ata/ahci.c b/drivers/ata/ahci.c
index ed80976eee77ef9bad6e049bdd5db77478199542..243e4b8e49b21b805396afff938f24f56c610396 100644
--- a/drivers/ata/ahci.c
+++ b/drivers/ata/ahci.c
@@ -1766,7 +1766,8 @@ static void ahci_init_irq(struct pci_dev *pdev, unsigned int n_ports,
 
 	#ifdef CONFIG_X86_PS4
 	if (pdev->vendor == PCI_VENDOR_ID_SONY) {
-		return apcie_assign_irqs(pdev, n_ports);
+		apcie_assign_irqs(pdev, n_ports);
+		return;
 	}
 	#endif
 	
