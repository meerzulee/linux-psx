From ff3b7d346da4876658ae7e7ef180bd5cad875077 Mon Sep 17 00:00:00 2001
From: rmuxnet <armandas.kvietkus@proton.me>
Date: Fri, 15 May 2026 10:49:30 +0000
Subject: [PATCH] drm/amdgpu: gmc7: report correct VRAM type for PS4
 Liverpool/Gladius

Liverpool and Gladius APUs use unified GDDR5 memory.  Report the
correct type instead of UNKNOWN so userspace tooling displays
accurate memory information.
---
 drivers/gpu/drm/amd/amdgpu/gmc_v7_0.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/gpu/drm/amd/amdgpu/gmc_v7_0.c b/drivers/gpu/drm/amd/amdgpu/gmc_v7_0.c
index 879fc66f77058fb3cf09affb29c1e2009990fab9..1daedecf8362632ce83a467e8589f59601243991 100644
--- a/drivers/gpu/drm/amd/amdgpu/gmc_v7_0.c
+++ b/drivers/gpu/drm/amd/amdgpu/gmc_v7_0.c
@@ -1009,6 +1009,9 @@ static int gmc_v7_0_sw_init(struct amdgpu_ip_block *ip_block)
 
 	if (adev->flags & AMD_IS_APU) {
 		adev->gmc.vram_type = AMDGPU_VRAM_TYPE_UNKNOWN;
+		if (adev->asic_type == CHIP_LIVERPOOL ||
+		    adev->asic_type == CHIP_GLADIUS)
+			adev->gmc.vram_type = AMDGPU_VRAM_TYPE_GDDR5;
 	} else {
 		u32 tmp = RREG32(mmMC_SEQ_MISC0);
 
